    {
      "turn_id": 1,
      "text": "Good evening . Do you have a reservation ?"
    },
    {
      "turn_id": 3,
      "text": "How many people are you together ?"
    },
    {
      "turn_id": 5,
      "text": "Would you like to sit in a smoking section , a non-smoking section or whatever comes open first ?"
    },
    {
      "turn_id": 7,
      "text": "I am awfully sorry but there are no vacancies left now . Would you like to wait for a moment ?"
    },
    {
      "turn_id": 9,
      "text": "I think about ten minutes ."
    },
    {
      "turn_id": 11,
      "text": "I am sorry for making you wait so long . Now there is a table available in non-smoking section . Please follow me ."
    },
    {
      "turn_id": 13,
      "text": "This is the menu . Are you ready to order now ?"
    },
    {
      "turn_id": 15,
      "text": "Yes , and what would you like to drink ?"
    },
    {
      "turn_id": 17,
      "text": "Would you like a dessert ?"
    }
