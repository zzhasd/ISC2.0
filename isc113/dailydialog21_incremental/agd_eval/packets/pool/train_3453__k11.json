  "visible_turns": [
    {
      "turn_id": 1,
      "text": "Can I help you ?"
    },
    {
      "turn_id": 3,
      "text": "Are you a professor ?"
    },
    {
      "turn_id": 5,
      "text": "Yes , I am kidding.But don't you know only professors and students with disabilitiescan apply for parking permits ?"
    },
    {
      "turn_id": 7,
      "text": "Oh , I'm sorry . I didn't know ."
    },
    {
      "turn_id": 9,
      "text": "Here is the application form . I also need to see your student ID and your permission letter from the university ."
    },
    {
      "turn_id": 11,
      "text": "Yes , the letter that certifies you have a disability.And it must certify your disability entitles you to a parking place ."
    },
    {
      "turn_id": 13,
      "text": "Yes . Or you can bring it yourself ."
    },
    {
      "turn_id": 15,
      "text": "Let me look in the file then . Maybe we received it ."
    },
    {
      "turn_id": 17,
      "text": "Yes , here it is.Alright . Then I just need your completed application form , and I will be able to process your request ."
    },
    {
      "turn_id": 19,
      "text": "The form has a map on the back . You may specify your top four choices.We will give a spot in the lot that has an opening ."
    },
    {
      "turn_id": 21,
      "text": "You're very welcome ."
    }
  ],
