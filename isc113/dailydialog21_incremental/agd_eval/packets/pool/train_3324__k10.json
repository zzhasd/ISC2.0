{
  "prefix_id": "train_3324__k10",
  "visible_turns": [
    {
      "turn_id": 1,
      "text": "Hey , Jenny . Would you like to go to dinner with me ?"
    },
    {
      "turn_id": 3,
      "text": "No , I don't . What do they say about office romances ?"
    },
    {
      "turn_id": 5,
      "text": "That's silly . What I do on my own time is no one else ’ s business . Besides , it's pretty hard to meet people outside of the office when we spend long hours here ."
    },
    {
      "turn_id": 7,
      "text": "People fall in love with people they work with . That's a fact ."
    },
    {
      "turn_id": 9,
      "text": "If it does , it will only make you more productive , because we can support each other ."
    },
    {
      "turn_id": 11,
      "text": "Good grief . All I did was ask you out . I am sorry ."
    },
    {
      "turn_id": 13,
      "text": "I am talking about dinner tonight , not a lifetime ."
    },
    {
      "turn_id": 15,
      "text": "I like company ."
    },
    {
      "turn_id": 17,
      "text": "What can I say ? I am a passionate guy ."
    },
    {
      "turn_id": 19,
      "text": "You want to go out with me and you know it ."
    }
  ],
