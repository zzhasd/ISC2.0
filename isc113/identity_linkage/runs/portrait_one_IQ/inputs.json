        {
          "turn_id": 12,
          "text": "でもオーブいっぱいもらえるからいいですよね"
        },
        {
          "turn_id": 13,
          "text": "それでぎりぎり続けてられますね"
        },
        {
          "turn_id": 14,
          "text": "課金なしでできるのもあのゲームは優秀ですね"
