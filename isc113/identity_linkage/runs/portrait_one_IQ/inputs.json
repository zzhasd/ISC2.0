{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "最近暑いですねーそちらはどうですか？"
        },
        {
          "turn_id": 3,
          "text": "雨なんですね！こちらも今日は雨でしたよー"
        },
        {
          "turn_id": 4,
          "text": "ですよねーでも暑い中だとかなり恵みですね"
        },
        {
          "turn_id": 5,
          "text": "ですよねー最近は割と涼しい日が増えてる気がします"
        },
        {
          "turn_id": 6,
          "text": "ですよねーそちらは何度くらいまでいきました？"
        },
        {
          "turn_id": 7,
          "text": "まじですか！僕は汗っかきなのでマジきついっす"
        },
        {
          "turn_id": 8,
          "text": "汗っかきマジできついっすよね、、学校ついただけで汗だくです"
        },
        {
          "turn_id": 9,
          "text": "実はまだ大学生ですよー"
        },
        {
          "turn_id": 10,
          "text": "まじですか！ちなみに何年生ですか？"
        },
        {
          "turn_id": 11,
          "text": "僕は３年生なので１つ先輩ですね！"
        },
        {
          "turn_id": 12,
          "text": "そうですよーちなみにどんな事学んでます？"
        },
        {
          "turn_id": 13,
          "text": "理系なんですね！僕も理系ですよ！"
        },
        {
          "turn_id": 14,
          "text": "僕は数学科ですね！"
        },
        {
          "turn_id": 15,
          "text": "授業めっちゃ大変ですよー"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "趣味は麻雀ですね！"
        },
        {
          "turn_id": 3,
          "text": "そうなんですか！最初難しくないですか？"
        },
        {
          "turn_id": 4,
          "text": "やっぱりそこですよねーどれくらい覚えますか？"
        },
        {
          "turn_id": 5,
          "text": "ちなみにすでにどれくらい覚えてます？"
        },
        {
          "turn_id": 6,
          "text": "１つ！ちなみに何ですか？"
        },
        {
          "turn_id": 7,
          "text": "まさかの役満ですか！すごいですね"
        },
        {
          "turn_id": 8,
          "text": "でも確かにかっこいいですよね！"
        },
        {
          "turn_id": 9,
          "text": "やっぱりオンラインゲームが多いですね"
        },
        {
          "turn_id": 10,
          "text": "それはわかりますね、たばことかのイメージありますよね"
        },
        {
          "turn_id": 11,
          "text": "確かに今だとそれもありますね、、コロナにはなりました？"
        },
        {
          "turn_id": 12,
          "text": "僕もまだ耐えてますね！でも周りはほぼなりましたね"
        },
        {
          "turn_id": 13,
          "text": "ですよねーやっても感染しちゃいますもんね"
        },
        {
          "turn_id": 14,
          "text": "そうなんです。かかっても仕方ない気はしますけどここまで来たら回避したいですね"
        },
        {
          "turn_id": 15,
          "text": "お互い頑張りましょう！"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんはー！"
        },
        {
          "turn_id": 2,
          "text": "暑いですね！アイスは食べますか？"
        },
        {
          "turn_id": 3,
          "text": "ですよねー何のアイスが好きですか？"
        },
        {
          "turn_id": 4,
          "text": "何味が好きなんですか？"
        },
        {
          "turn_id": 5,
          "text": "それってめっちゃ一瞬じゃなかったでしたっけ？"
        },
        {
          "turn_id": 6,
          "text": "僕もおいしかった記憶ありますね！あとはナポリタン味とか"
        },
        {
          "turn_id": 7,
          "text": "それは知らないっすねー最近だと何味が好きですか？"
        },
        {
          "turn_id": 8,
          "text": "あー確かにシンプル！"
        },
        {
          "turn_id": 9,
          "text": "僕は最近ハーゲンダッツゲーセンで取って食べます！"
        },
        {
          "turn_id": 10,
          "text": "ＵＦＯキャッチャーで取ってます！"
        },
        {
          "turn_id": 11,
          "text": "割と２００円かからず取れることが多いですよ！"
        },
        {
          "turn_id": 12,
          "text": "僕はどのアイスもやっぱりバニラですね！"
        },
        {
          "turn_id": 13,
          "text": "牧場のバニラとかマジで最高っす"
        },
        {
          "turn_id": 14,
          "text": "マジでいいですよね！なんだかんだバニラがおいしい"
        },
        {
          "turn_id": 15,
          "text": "でも僕は抹茶も好きですね！"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "僕は宇多田ヒカルの大ファンですね！"
        },
        {
          "turn_id": 3,
          "text": "マジっすか！一緒ですね！"
        },
        {
          "turn_id": 4,
          "text": "最近はまってるのはtravelingですね！"
        },
        {
          "turn_id": 5,
          "text": "そうなんです！そちらは？"
        },
        {
          "turn_id": 6,
          "text": "アーキングダムのやつですよね！僕はそれの英語版聞きますよー"
        },
        {
          "turn_id": 7,
          "text": "そうなんですよー割と英語版ある曲多いですよー"
        },
        {
          "turn_id": 8,
          "text": "誓いとか一応Automaticにもありますよー"
        },
        {
          "turn_id": 9,
          "text": "是非聞いてみてください！他に聞く曲あります？"
        },
        {
          "turn_id": 10,
          "text": "椎名林檎も僕好きなんですよーその曲も知ってます！"
        },
        {
          "turn_id": 11,
          "text": "２時間だけのバカンスはご存じですか？"
        },
        {
          "turn_id": 12,
          "text": "めっちゃわかります！マジで好き"
        },
        {
          "turn_id": 13,
          "text": "あの二人の新曲ほしいですよね！"
        },
        {
          "turn_id": 14,
          "text": "宇多田ヒカルにいないこと多いから難しいかなー"
        },
        {
          "turn_id": 15,
          "text": "そうですね！"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "趣味とかあります？"
        },
        {
          "turn_id": 3,
          "text": "おートランプとかですか？"
        },
        {
          "turn_id": 4,
          "text": "あー知ってます！昔やってました"
        },
        {
          "turn_id": 5,
          "text": "何デッキってことですか？"
        },
        {
          "turn_id": 6,
          "text": "ちょっと前ですけど恐竜デッキつかってました！"
        },
        {
          "turn_id": 7,
          "text": "僕の時も強かったですね！今も強いですか？"
        },
        {
          "turn_id": 8,
          "text": "なんかうれしい！俺も始めようかな"
        },
        {
          "turn_id": 9,
          "text": "それ最近までやってましたよ！"
        },
        {
          "turn_id": 10,
          "text": "６月くらいですね！その時まで恐竜デッキでやってましたね"
        },
        {
          "turn_id": 11,
          "text": "エルドリッチデッキとかすごい多かった気がします"
        },
        {
          "turn_id": 12,
          "text": "そうなんですね！あのデッキには結構腹立ててましたね"
        },
        {
          "turn_id": 13,
          "text": "あーそれカードでやってた時はやってましたね"
        },
        {
          "turn_id": 14,
          "text": "ちょいちょい規制がかかり始めてた気はしますね"
        },
        {
          "turn_id": 15,
          "text": "それが流行り始めたくらいで辞めましたね"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは！"
        },
        {
          "turn_id": 2,
          "text": "こっちも暑いですよ！汗だらだらです"
        },
        {
          "turn_id": 3,
          "text": "なんかスポーツとかやってます？"
        },
        {
          "turn_id": 4,
          "text": "僕もやってます！マラソン頑張ってます！"
        },
        {
          "turn_id": 5,
          "text": "マジで大変ですよ！最近は練習中断してます"
        },
        {
          "turn_id": 6,
          "text": "実は７月くらいにハーフマラソン出て暑くてやばかったです"
        },
        {
          "turn_id": 7,
          "text": "暑くて途中でやめちゃいましたね"
        },
        {
          "turn_id": 8,
          "text": "暑すぎて皆辞めてましたね"
        },
        {
          "turn_id": 9,
          "text": "マジで途中からスピード遅くなりますね"
        },
        {
          "turn_id": 10,
          "text": "結構みんなリタイアでしたねでも僕の友達はゴールしてましたね"
        },
        {
          "turn_id": 11,
          "text": "めっちゃ尊敬しますねマジですごいです"
        },
        {
          "turn_id": 12,
          "text": "中学のころ陸上で全国出てましたね！"
        },
        {
          "turn_id": 13,
          "text": "僕も一応中高陸上部でしたよー"
        },
        {
          "turn_id": 14,
          "text": "まじすっか！共通点多いっすね"
        },
        {
          "turn_id": 15,
          "text": "友達になれそう！"
        }
      ]
    },
    {
