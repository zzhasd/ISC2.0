{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こちらこそよろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "今は、あまり趣味的なものがなくて。。どんな絵を描かれるのですか？"
        },
        {
          "turn_id": 3,
          "text": "画材はどんな種類をつかっているのでしょう？"
        },
        {
          "turn_id": 4,
          "text": "デジタルなんですね！デジタルで絵を描くのはどんな感じなんでしょう？"
        },
        {
          "turn_id": 5,
          "text": "実は、娘が最近パソコンで絵を描きたいと言っていて、調べている所なんです。"
        },
        {
          "turn_id": 6,
          "text": "そうそう。板タブと言うものですよね。"
        },
        {
          "turn_id": 7,
          "text": "そうなんです。最初は液タブがいいとか言ってたのですが、あまりの価格の高さにびっくりしました。"
        },
        {
          "turn_id": 8,
          "text": "とりあえず、小さめの板タブをオークションで探しています。ソフトは何が必要なんでしょう？"
        },
        {
          "turn_id": 9,
          "text": "なるほど。この手の専用ソフトは高価なイメージがありますね。"
        },
        {
          "turn_id": 10,
          "text": "そうですね。まだ、続けられるかどうかわからないので、最初はなるべく安くそろえようとしています。"
        },
        {
          "turn_id": 11,
          "text": "道具もいろいろ進化していて、びっくりしますね。"
        },
        {
          "turn_id": 12,
          "text": "もう、アナログには戻れない感じですか？"
        },
        {
          "turn_id": 13,
          "text": "なるほど。私は、アナログな人間なので、ちょっとついていけないです。"
        },
        {
          "turn_id": 14,
          "text": "貴重な情報をありがとうございました。とても助かります。"
        },
        {
          "turn_id": 15,
          "text": "またお話しましょう。ではまた！"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "今年の夏はどこかに行きましたか？"
        },
        {
          "turn_id": 3,
          "text": "仙台！いいですね。"
        },
        {
          "turn_id": 4,
          "text": "仙台は一度だけ行ったことがあります。"
        },
        {
          "turn_id": 5,
          "text": "震災の後で、ちょっとだけお手伝いに行ってきました。"
        },
        {
          "turn_id": 6,
          "text": "ほんとに大変でした。あんな事が現実に起こるとは思いませんでしたよ。"
        },
        {
          "turn_id": 7,
          "text": "そうなんですね。私もその時は関東に住んでて。。すごい揺れでした。"
        },
        {
          "turn_id": 8,
          "text": "ほんとにそんな感じでしたよね。私もその時いた建物が古くて、とても怖かったです。"
        },
        {
          "turn_id": 9,
          "text": "今度は、ゆっくりと観光で東北に行ってみたいです。仙台以外にはどこかにいったのですか？"
        },
        {
          "turn_id": 10,
          "text": "そんな旅行もいいと思います。ついつい予定を入れすぎてしまうのでゆっくり旅にあこがれます。"
        },
        {
          "turn_id": 11,
          "text": "そんな時間も貴重ですよね！"
        },
        {
          "turn_id": 12,
          "text": "あ！いいですね。仙台と言えば牛タンですかね？"
        },
        {
          "turn_id": 13,
          "text": "いいなあ。そういえば最近焼き肉を言うものを食べてないです。"
        },
        {
          "turn_id": 14,
          "text": "うちは、子どもがあまり焼き肉が好きでないので、焼き肉屋さんにはなかなか行けないんです。"
        },
        {
          "turn_id": 15,
          "text": "そうなんですよね。ハンバーグは好きなのですが。。"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こちらこそよろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "こちらもびっくりするぐらい寒いです。"
        },
        {
          "turn_id": 3,
          "text": "今週の月曜日は、まだ暑い！って言ってたのですが。。ウソみたいです。"
        },
        {
          "turn_id": 4,
          "text": "ほんとうですね。急に寒くなると準備が大変です。"
        },
        {
          "turn_id": 5,
          "text": "それは難しいですね！私の子どもは今日から冬服を着ていきました。"
        },
        {
          "turn_id": 6,
          "text": "最近の学校は、冬服と夏服、どちらでも良い期間というのがあって助かります。"
        },
        {
          "turn_id": 7,
          "text": "以前は、この日に衣替え！って感じでしたけど、年によって気候はだいぶ違いますからね！"
        },
        {
          "turn_id": 8,
          "text": "そうですよね。みんな一斉に変わりましたよね。今は、かなり自由度が高いみたいです。"
        },
        {
          "turn_id": 9,
          "text": "そうだと思います。しかしこれだけ寒いとそろそろストーブが必要になりますね。"
        },
        {
          "turn_id": 10,
          "text": "風邪をひかないように気を付けましょう！"
        },
        {
          "turn_id": 11,
          "text": "うちは、寒くなると、鍋料理の頻度がすっごくあがります。"
        },
        {
          "turn_id": 12,
          "text": "おでんも美味しいですよね！おでんの頻度も高いですよー。"
        },
        {
          "turn_id": 13,
          "text": "コンビニのおでん美味しいですよね！でも最近売っている店舗が減っている気がします。"
        },
        {
          "turn_id": 14,
          "text": "そうなんですね。もしかしたらコロナの影響で、場所を変えているのかもしれません。"
        },
        {
          "turn_id": 15,
          "text": "こちらこそありがとうございました。"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！よろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "災害への備えって何かしていますか？"
        },
        {
          "turn_id": 3,
          "text": "実は最近、私の住んでいる県は、ものすごい水害が起きてしまって、いろいろ大変でした。"
        },
        {
          "turn_id": 4,
          "text": "水道も何日も止まってしまった場所があって、災害への備えが大事だなと思いました。"
        },
        {
          "turn_id": 5,
          "text": "今まであまり水害はなかったので、今回はびっくりしました。"
        },
        {
          "turn_id": 6,
          "text": "そうです。この前の台風です。ピンポイントでうちの県がやられちゃいました。"
        },
        {
          "turn_id": 7,
          "text": "私の母親は、新幹線が途中で止まってしまって、大変な目にあってしまいましたよ。"
        },
        {
          "turn_id": 8,
          "text": "結局、復旧したのが次の日の昼で、へとへとになって帰ってきました。"
        },
        {
          "turn_id": 9,
          "text": "こんな事は、いままでなかったと思います。"
        },
        {
          "turn_id": 10,
          "text": "今回は、とにかく水が足りなかったので、今後しっかりと備えておこうと思いました。"
        },
        {
          "turn_id": 11,
          "text": "ペットボトルも大事ですが、10リットルぐらい入る、タンクをいくつか保管しておくといいですよ！"
        },
        {
          "turn_id": 12,
          "text": "生活用水が結構いるので。。給水車から水を貰うときに、ある程度大きなタンクが便利です。"
        },
        {
          "turn_id": 13,
          "text": "ぜひぜひ！検討してみてください。"
        },
        {
          "turn_id": 14,
          "text": "そうなんですよ。いつの間にか古くなってダメになっていたりします。"
        },
        {
          "turn_id": 15,
          "text": "そうなんです。気を付けなくてはいけませんね！"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "学生さんなんですね！私は学生時代は遠い昔になってしまいました。どんなことを学んでいるのですか？"
        },
        {
          "turn_id": 3,
          "text": "その研究は、どんな事に役に立つのでしょうか？"
        },
        {
          "turn_id": 4,
          "text": "なるほど。そうなんですね。すいません。ちょっと私と縁遠い分野だったので、変な質問をしました。"
        },
        {
          "turn_id": 5,
          "text": "最近、ほんとに生物の体って良くできているなあと感じます。"
        },
        {
          "turn_id": 6,
          "text": "遺伝子と言うのはDNAとかRNAとかいうものでしたっけ？"
        },
        {
          "turn_id": 7,
          "text": "いったい、この仕組みはどうやってできたのか。すごく不思議です。"
        },
        {
          "turn_id": 8,
          "text": "そうなんですね。例えばどんな生き物を扱っているのでしょう？"
        },
        {
          "turn_id": 9,
          "text": "貝の仲間でしたっけ？違ったかな？"
        },
        {
          "turn_id": 10,
          "text": "え！そうなんですか。貝よりヒトに近いのですか！"
        },
        {
          "turn_id": 11,
          "text": "うーん。やっぱり生き物って不思議です。"
        },
        {
          "turn_id": 12,
          "text": "ですよね。確かどこかで食べた事があります。そっか。あれは貝ではなかったのか。"
        },
        {
          "turn_id": 13,
          "text": "そういえば、遺伝子という物は、顕微鏡などで見ることができるのですか？"
        },
        {
          "turn_id": 14,
          "text": "そうなんですね！ではどうやって調べるのでしょう？"
        },
        {
          "turn_id": 15,
          "text": "なるほど。それは難しい。貴重なお話をありがとうございました。"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "もうお昼は食べられましたか？"
        },
        {
          "turn_id": 3,
          "text": "食パンには何を塗りますか？"
        },
        {
          "turn_id": 4,
          "text": "いいですね。私はチーズとハムを乗せて焼いたりすることがあります"
        },
        {
          "turn_id": 5,
          "text": "はい。食べました"
        },
        {
          "turn_id": 6,
          "text": "赤いきつねです。カップ麺ですね。"
        },
        {
          "turn_id": 7,
          "text": "赤いきつねが好きですね。油揚げが好きなので"
        },
        {
          "turn_id": 8,
          "text": "そうなのですね。どちらかというとうどんが好きなので、そういう意味でも赤いきつねの方が好きですね"
        },
        {
          "turn_id": 9,
          "text": "学食だと麺類はきっとお安いでしょう"
        },
        {
          "turn_id": 10,
          "text": "どういう種類があるんですか？"
        },
        {
          "turn_id": 11,
          "text": "いいですね。今の季節はどういう限定うどんがありますか？"
        },
        {
          "turn_id": 12,
          "text": "そうだったのですね。大学生は夏休みが長いので良いですよね。"
        },
        {
          "turn_id": 13,
          "text": "いつまで夏休みだったんですか？"
        },
        {
          "turn_id": 14,
          "text": "8月～9月ってことでしょうか。それは長いですね。"
        },
        {
          "turn_id": 15,
          "text": "休み中も勉学に励んでいたのは立派です。"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "特に行っていないですね。あなたはどうですか？"
        },
        {
          "turn_id": 3,
          "text": "仙台いいですね。夏だと涼しそうです。"
        },
        {
          "turn_id": 4,
          "text": "関東よりも東北の方が涼しそうな印象ですが、変わらなかったですか？"
        },
        {
          "turn_id": 5,
          "text": "台風が来ていたのですね。大変でしたね。"
        },
        {
          "turn_id": 6,
          "text": "被害がなかったのは何よりです。"
        },
        {
          "turn_id": 7,
          "text": "仙台へは観光目的で行かれたのではないのですか？"
        },
        {
          "turn_id": 8,
          "text": "そうだったのですね。楽しかったですか？"
        },
        {
          "turn_id": 9,
          "text": "何のゲームをしたんですか？"
        },
        {
          "turn_id": 10,
          "text": "マインクラフトは私も1度やったことがあります。何かを作ったりしたんですか？"
        },
        {
          "turn_id": 11,
          "text": "今はオンラインで全国の人と遊べるので良いですよね"
        },
        {
          "turn_id": 12,
          "text": "オンラインで知り合ったご友人なんですか？"
        },
        {
          "turn_id": 13,
          "text": "進学を切っ掛けに友人がバラバラになるのはさみしいですね"
        },
        {
          "turn_id": 14,
          "text": "社会人になったらもっとタイミングが合わなくなると思うので今の時間を大切にしてください。"
        },
        {
          "turn_id": 15,
          "text": "はい、楽しんでください。"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "この秋どこか旅行される予定はありますか？"
        },
        {
          "turn_id": 3,
          "text": "浅草いいですね。何か目的があるんですか？"
        },
        {
          "turn_id": 4,
          "text": "なるほど。なぜ浅草に？"
        },
        {
          "turn_id": 5,
          "text": "中間地点なのですね。ソラマチとかも良いかと思ったのですが。"
        },
        {
          "turn_id": 6,
          "text": "ソラマチから浅草は歩いていける距離なのでオススメですよ"
        },
        {
          "turn_id": 7,
          "text": "そういうわけではないですが、私も関東に住んでいるので都内にはよく出ますね"
        },
        {
          "turn_id": 8,
          "text": "まだ流行っているので電車乗るのとかは怖いですよね"
        },
        {
          "turn_id": 9,
          "text": "都内に通勤してますが、通勤でコロナには罹ってないですね。家族から先日移されました。"
        },
        {
          "turn_id": 10,
          "text": "罹らないほうが良いですよ。未だに咳が出ているので"
        },
        {
          "turn_id": 11,
          "text": "休養中は味覚もなくなりましたね"
        },
        {
          "turn_id": 12,
          "text": "後遺症として残らなかったのは良かったですが。罹らないよう気を付けてください"
        },
        {
          "turn_id": 13,
          "text": "外歩いている時に周りに人がいなければ外しても良いと思いますよ"
        },
        {
          "turn_id": 14,
          "text": "正直、それくらいでは移らないと思います。"
        },
        {
          "turn_id": 15,
          "text": "今後も予防徹底して罹らないように気を付けてくださいね"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします"
        },
        {
          "turn_id": 2,
          "text": "寒いですね。15度以下ですよね"
        },
        {
          "turn_id": 3,
          "text": "急に気温が下がりましたね。ついていけません"
        },
        {
          "turn_id": 4,
          "text": "まだ衣替えしていなくて、部屋着は夏服のままなので寒いです"
        },
        {
          "turn_id": 5,
          "text": "私はまだ羽毛布団一枚なので寒いです。"
        },
        {
          "turn_id": 6,
          "text": "そうですね。冷えでお腹を壊してしまいます"
        },
        {
          "turn_id": 7,
          "text": "昼間と夜、ここでも気温差かなり違いますもんね"
        },
        {
          "turn_id": 8,
          "text": "夜だと寒そうですね"
        },
        {
          "turn_id": 9,
          "text": "昨晩も雨降りませんでしたっけ？"
        },
        {
          "turn_id": 10,
          "text": "それは寒いですね。夜は湯船に浸かる事が必須ですね"
        },
        {
          "turn_id": 11,
          "text": "うちも夏場はシャワーだけですが、今週からお湯を張ってます"
        },
        {
          "turn_id": 12,
          "text": "入浴剤入れると気分あがりますよね"
        },
        {
          "turn_id": 13,
          "text": "今日、さっそくお湯を張ってみてはいかがでしょうか。寒いですし"
        },
        {
          "turn_id": 14,
          "text": "暫く使ってないと掃除も念入りにしないとですね。"
        },
        {
          "turn_id": 15,
          "text": "がんばってください。"
        }
      ]
    },
    {
      "dialogue": "D10",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "今日は一日何をされる予定ですか？"
        },
        {
          "turn_id": 3,
          "text": "いいですね。なんのゲームをされるんですか？"
        },
        {
          "turn_id": 4,
          "text": "ゲームが趣味なんですか？"
        },
        {
          "turn_id": 5,
          "text": "そうなのですね。協力するゲームが多いんですか？"
        },
        {
          "turn_id": 6,
          "text": "今はオンラインゲームが主流なのですね。"
        },
        {
          "turn_id": 7,
          "text": "ネットを使う事が当たり前の時代になりましたもんね。"
        },
        {
          "turn_id": 8,
          "text": "ネットショッピングも便利ですよね。Amazonとか"
        },
        {
          "turn_id": 9,
          "text": "サイズ感があるものは怖いですよね。"
        },
        {
          "turn_id": 10,
          "text": "わかります。私も服は買えないです。"
        },
        {
          "turn_id": 11,
          "text": "実店舗があるお店ならいいんですけどね。"
        },
        {
          "turn_id": 12,
          "text": "ネットは買わないほうが良いですね。安いですけど。"
        },
        {
          "turn_id": 13,
          "text": "好きですね。見るのも好きです。なのでネットで服はよく見ます。"
        },
        {
          "turn_id": 14,
          "text": "一度ネットで買ったことがあるのですが、縫製が雑でびっくりしました。それ以来買ってません"
        },
        {
          "turn_id": 15,
          "text": "はい。実物を見た方が間違いないですね。ネットで買うのはやはり怖いですね。"
        }
      ]
    },
    {
      "dialogue": "D11",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "水を飲んでます。"
        },
        {
          "turn_id": 3,
          "text": "基本的にお茶か水ですね。出先でたまに珈琲を飲む程度です"
        },
        {
          "turn_id": 4,
