    "statement": "私は主婦だ。"
  },
  {
    "archive_id": "P2",
    "statement": "東京都出身である。"
  },
  {
    "archive_id": "P3",
    "statement": "甘いものが大好きだ。"
  },
  {
    "archive_id": "P4",
