{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちはー！"
        },
        {
          "turn_id": 2,
          "text": "暑かったー。もう外に出たくない。"
        },
        {
          "turn_id": 3,
          "text": "買い物行くのも大変だし、食欲もないです"
        },
        {
          "turn_id": 4,
          "text": "もう夜のご飯たべました？"
        },
        {
          "turn_id": 5,
          "text": "お蕎麦いいですね。私、お水ですぐ作れるお蕎麦愛用してます。"
        },
        {
          "turn_id": 6,
          "text": "めっちゃ楽ですよね！うどんバージョンも時々買います。"
        },
        {
          "turn_id": 7,
          "text": "ぜひ！　確かそうめんとか冷麺もあったような。"
        },
        {
          "turn_id": 8,
          "text": "冷麺は、今年初めて見たんだけど、びっくりしました！"
        },
        {
          "turn_id": 9,
          "text": "キッチンが汚れるもんね。水だけってのは画期的でありがたいー！"
        },
        {
          "turn_id": 10,
          "text": "あと茹でる時の、熱！　あれけっこうしんどいです。"
        },
        {
          "turn_id": 11,
          "text": "私、ごはん派なんですが、麺好きなんですか？"
        },
        {
          "turn_id": 12,
          "text": "パンはあんまり食べないかも。朝もごはんです。"
        },
        {
          "turn_id": 13,
          "text": "あはは。なるほど。"
        },
        {
          "turn_id": 14,
          "text": "じゃあ麺なら、何が一番好きですか？"
        },
        {
          "turn_id": 15,
          "text": "おぉー！渋い。わさびそばですね！"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "私、麺なら、やっぱりうどんが好きかも。"
        },
        {
          "turn_id": 2,
          "text": "悩みますが、あったかいのがいいかな"
        },
        {
          "turn_id": 3,
          "text": "贅沢に、えび天がいい！"
        },
        {
          "turn_id": 4,
          "text": "好きなトッピングありますか？"
        },
        {
          "turn_id": 5,
          "text": "たっぷりわかめもおいしいですよね。たまごもつけたい！"
        },
        {
          "turn_id": 6,
          "text": "ちくわ天も好きだし、うどんが見えなくなりそう。"
        },
        {
          "turn_id": 7,
          "text": "安いけど、贅沢な感じがしていいですよね。山盛りトッピング！"
        },
        {
          "turn_id": 8,
          "text": "食べきれないかも。ははは。"
        },
        {
          "turn_id": 9,
          "text": "いいですね！　ところで、麺なら何でも好きなんですか？ラーメンとかも。"
        },
        {
          "turn_id": 10,
          "text": "え？　なんでなんで？？"
        },
        {
          "turn_id": 11,
          "text": "男の人ばっかりだからかな？　作るのは得意ですか？"
        },
        {
          "turn_id": 12,
          "text": "自分で作ると、好きなもの入れられますもんね。嫌いなものも抜けるし！"
        },
        {
          "turn_id": 13,
          "text": "いいですねー。おなかすいてきました。"
        },
        {
          "turn_id": 14,
          "text": "まだです。食欲ないかなって思ってたけど、しゃべってるうちに麺が食べたくなってきました！"
        },
        {
          "turn_id": 15,
          "text": "おいしい話、ありがたいです！"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "今年は、水出しの紅茶にハマってます。"
        },
        {
          "turn_id": 2,
          "text": "なんか、カフェインがお湯の時よりも少ないらしくて、ガブガブいけますよー！"
        },
        {
          "turn_id": 3,
          "text": "専用の茶葉もあるんですが、普通のティーパックでもいけるらしいです。味もいろいろ。"
        },
        {
          "turn_id": 4,
          "text": "私、それ飲んだことないかも。名前はよく聞きますよね。"
        },
        {
          "turn_id": 5,
          "text": "おお！ビタミンＣ！　美肌と言われると、興味わいてきますね。"
        },
        {
          "turn_id": 6,
          "text": "はい。やっぱり、効果あるとか言われると気になってしまう。"
        },
        {
          "turn_id": 7,
          "text": "一生懸命！　なんかかわいい。"
        },
        {
          "turn_id": 8,
          "text": "気持ちが大事ー！　ははは。"
        },
        {
          "turn_id": 9,
          "text": "私、ペットボトルだと緑茶派なんですが、好きな飲み物とかありますか？"
        },
        {
          "turn_id": 10,
          "text": "おおー！　コーヒーって色々種類ありますよねー。奥が深そう。"
        },
        {
          "turn_id": 11,
          "text": "それで目が覚める的な？"
        },
        {
          "turn_id": 12,
          "text": "へええ！　もしかして、ブラックですか？"
        },
        {
          "turn_id": 13,
          "text": "コーヒー、苦いと感じるので、それはもうたっぷりのミルクと砂糖を…"
        },
        {
          "turn_id": 14,
          "text": "そうです。ほぼジュースみたいなのが好きです。"
        },
        {
          "turn_id": 15,
          "text": "ふふふ。甘党へようこそ！"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "何か趣味とか好きなことってありますか？"
        },
        {
          "turn_id": 2,
          "text": "おおー！何系見てるんですか？"
        },
        {
          "turn_id": 3,
          "text": "動物！　いいですよね。私もInstagramとかで、動物ずっと見てます。"
        },
        {
          "turn_id": 4,
          "text": "私、犬が大好きで、特にビションフリーゼをよく見てます。"
        },
        {
          "turn_id": 5,
          "text": "小型犬です。アフロ犬って呼ばれてる、白くてふわふわのプードルとマルチーズみたいな感じの犬です。"
        },
        {
          "turn_id": 6,
          "text": "綿あめみたいな感じです。"
        },
        {
          "turn_id": 7,
          "text": "見た目かわいいのに、どこか生意気な感じもあって、メロメロです。"
        },
        {
          "turn_id": 8,
          "text": "以前、実家にいたころに、わんこを飼ってました。今ひとりなので、さみしいですー！"
        },
        {
          "turn_id": 9,
          "text": "そうかも。ケンカしてると、すっとんできます！やめろーって。"
        },
        {
          "turn_id": 10,
          "text": "そうですね。もうやめるしかない。"
        },
        {
          "turn_id": 11,
          "text": "うーん。飼うならやっぱりわんこかなあ。でも、飼ってみたいのは、オウムです。"
        },
        {
          "turn_id": 12,
          "text": "そうですね。すごく長生きの子がいるらしくて、50年ぐらい生きるという。"
        },
        {
          "turn_id": 13,
          "text": "そうなんですよ！　だから、30代ぐらいで飼わないと、一生を添い遂げられないというのも、貴重。"
        },
        {
          "turn_id": 14,
          "text": "猫と一緒に飼うと、猫の鳴きマネとかしてますよね。動画で見たことあります。"
        },
        {
          "turn_id": 15,
          "text": "タイハクオウムとか、そういう名前の白い子です。かわいいのでぜひ！"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "趣味は、海外ドラマとか映画を見ることです。"
        },
        {
          "turn_id": 2,
          "text": "特に好きなのは、ミステリーとか、刑事モノですね。"
        },
        {
          "turn_id": 3,
          "text": "なるほど！　古畑任三郎のもとになったと言われているあれですね！"
        },
        {
          "turn_id": 4,
          "text": "けっこう映画とか見ますか？あんまりですか？"
        },
        {
          "turn_id": 5,
          "text": "あはは。確かに短い動画になれると、２時間つらい時ありますね。"
        },
        {
          "turn_id": 6,
          "text": "インド映画はほぼ見たことないです。昔、ムトゥ踊るマハラジャってはやってましたよね。"
        },
        {
          "turn_id": 7,
          "text": "インド映画好きなんですか？"
        },
        {
          "turn_id": 8,
          "text": "なるほど。ド派手ミュージカルのイメージぐらいしかないです。インド映画。"
        },
        {
          "turn_id": 9,
          "text": "あはは。確かに。私ミュージカル映画は好きです。アメリカのものばっかりですけど。"
        },
        {
          "turn_id": 10,
          "text": "なんか、楽しい気分になるので、好きですね。歌も好きだし。"
        },
        {
          "turn_id": 11,
          "text": "舞台とか見たりします？"
        },
        {
          "turn_id": 12,
          "text": "おお！　どんなオペラですか？？"
        },
        {
          "turn_id": 13,
          "text": "うわー！すてき！私はテレビで見るぐらいしか経験ないです。"
        },
        {
          "turn_id": 14,
          "text": "生オケですもんね、オペラって。すごいなあ。うらやましい！"
        },
        {
          "turn_id": 15,
          "text": "また観劇が気軽にできるようになるといいですよね。"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは、よろしくお願いします"
        },
        {
          "turn_id": 2,
          "text": "メチャメチャ暑いです、外出できそうにないです"
        },
        {
          "turn_id": 3,
          "text": "なるほど、じめじめして暑いと嫌ですね"
        },
        {
          "turn_id": 4,
          "text": "同感です、夏と冬はどちらが好きですか？"
        },
        {
          "turn_id": 5,
          "text": "ぼくも夏の方がいいです、昔は比較的涼しかったですね"
        },
        {
          "turn_id": 6,
          "text": "あまりニュースは見ませんが確かに気候がおかしいですね。"
        },
        {
          "turn_id": 7,
          "text": "はい、今月頭から休みです"
        },
        {
          "turn_id": 8,
          "text": "暑い中通勤通学するのは大変ですよね。"
        },
        {
          "turn_id": 9,
          "text": "家から駅までが本当に暑くて汗がダラダラ出ますね"
        },
        {
          "turn_id": 10,
          "text": "僕は使わないですね、折り畳みの小さい傘しか持ち歩かないです"
        },
        {
          "turn_id": 11,
          "text": "なかなか見ないですね。日傘の色におススメはありますか？"
        },
        {
          "turn_id": 12,
          "text": "なるほど、僕は黒い傘しかないのでちょうどいいかもしれないです"
        },
        {
          "turn_id": 13,
          "text": "ありがとうございます。限界を迎えたらさしてみますね"
        },
        {
          "turn_id": 14,
          "text": "兼用があるんですね。教えていただきありがとうございます"
        },
        {
          "turn_id": 15,
          "text": "戸締りはしたほうがいいですね。ではまた後程"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは、お天気はどうですか？"
        },
        {
          "turn_id": 2,
          "text": "そうなんですね。落雷の音は苦手なタイプですか？"
        },
        {
          "turn_id": 3,
          "text": "僕は平気な方ですが、妹がかなり苦手ですね"
        },
        {
          "turn_id": 4,
          "text": "家の中なら気にならないですが、外だと少し怖いですよね"
        },
        {
          "turn_id": 5,
          "text": "確率は低いですが、当たった時のことを考えると怖くなってきました"
        },
        {
          "turn_id": 6,
          "text": "こちらは少し曇っている程度ですね。暑いですが"
        },
        {
          "turn_id": 7,
          "text": "コンクリートがあるので、夜中でも暑いです"
        },
        {
          "turn_id": 8,
          "text": "そうですね。身動きのとりにくい状況になってきましたね"
        },
        {
          "turn_id": 9,
          "text": "僕はよくゲームをしますね。何か趣味はありますか？"
        },
        {
          "turn_id": 10,
          "text": "僕もよく動画を見ますね。ゲーム実況が多いですが"
        },
        {
          "turn_id": 11,
          "text": "ワイワイ実況者がゲームをしているのを観るとこちらも楽しくなれますよ"
        },
        {
          "turn_id": 12,
          "text": "人狼ゲームが好きですね。推理系が好きです"
        },
        {
          "turn_id": 13,
          "text": "RPGやアクション系も好きですけどね。"
        },
        {
          "turn_id": 14,
          "text": "マリオはマルチプレイできるので楽しいですよね。"
        },
        {
          "turn_id": 15,
          "text": "懐かしいですね。時間が見つかったらゲームやってみてください。"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "はい、もう食べちゃいました。"
        },
        {
          "turn_id": 2,
          "text": "カレーですか、甘口ですか？"
        },
        {
          "turn_id": 3,
          "text": "いいですね、僕は中辛が好きです"
        },
        {
          "turn_id": 4,
          "text": "そうですね、四川クラスはちょっと"
        },
        {
          "turn_id": 5,
          "text": "テレビで芸能人が激辛を食べているのを見るとぞわぞわしてきます"
        },
        {
          "turn_id": 6,
          "text": "そうですよね。市販の素で作る麻婆豆腐くらいが一番落ち着きます"
        },
        {
          "turn_id": 7,
          "text": "あまり料理はしないですね。そちらはどうですか？"
        },
        {
          "turn_id": 8,
          "text": "そうですよね、疲れてるとなかなか買い物にも行こうと思わないです"
        },
        {
          "turn_id": 9,
          "text": "Nashという宅配弁当に最近興味がありますね。"
        },
        {
          "turn_id": 10,
          "text": "恐らくそうですね、ある程度まとめて届くかもしれないですけど"
        },
        {
          "turn_id": 11,
          "text": "買い物や料理のコストを考えると多少高くてもいいのかなと思いますね"
        },
        {
          "turn_id": 12,
          "text": "片付けもありますし、なかなかやる気が起こらないですね"
        },
        {
          "turn_id": 13,
          "text": "かつての実家のありがたみを感じますね。"
        },
        {
          "turn_id": 14,
          "text": "ご実家は今のお住まいから近いですか？"
        },
        {
          "turn_id": 15,
          "text": "いいですね。僕は遠いです"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは、体調はどうですか？"
        },
        {
          "turn_id": 2,
          "text": "元気です。雨が降ると頭痛がしますけど"
        },
        {
          "turn_id": 3,
          "text": "天気からくる精神的なものも大きいかもしれないですね。"
        },
        {
          "turn_id": 4,
          "text": "今年の梅雨はあまり雨が降らなかった印象があります。"
        },
        {
          "turn_id": 5,
          "text": "はい、そんな感じでしたね。"
        },
        {
          "turn_id": 6,
          "text": "その代わり七月中旬は雨が多かったです"
        },
        {
          "turn_id": 7,
          "text": "農家の方もいますし、ダムもあるのでね。"
        },
        {
          "turn_id": 8,
          "text": "まさにそうです。野菜は高いと親が嘆いていましたね"
        },
        {
          "turn_id": 9,
          "text": "魚も高いらしいですね。"
        },
        {
          "turn_id": 10,
          "text": "調理がたいへんですからね、魚は"
        },
        {
          "turn_id": 11,
          "text": "僕も外食しないとお目にかかれないです、魚は"
        },
        {
          "turn_id": 12,
          "text": "同感です。揚げ物もそうですね"
        },
        {
          "turn_id": 13,
          "text": "油の処理とか面倒なことが多くて。"
        },
        {
          "turn_id": 14,
          "text": "下ごしらえとか、案外大変だと学びましたね"
        },
        {
          "turn_id": 15,
          "text": "味の濃さとか、大分変わりますよね。"
        }
      ]
    },
    {
      "dialogue": "D10",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "大学の先輩と久々に再会したことですかね"
        },
        {
          "turn_id": 2,
          "text": "二年半ぶりくらいです。こういった世の中なので"
        },
        {
          "turn_id": 3,
          "text": "そうですね。何か楽しかったイベントはありましたか？"
        },
        {
          "turn_id": 4,
          "text": "ネット通販いいですよね。クレカ登録してから使うようになりましたね"
        },
        {
          "turn_id": 5,
          "text": "欲しいものが出かけずに手に入るなんて悪魔的です"
        },
        {
          "turn_id": 6,
          "text": "サイトは何を使っていますか？"
        },
        {
          "turn_id": 7,
          "text": "無難ですよね。僕もAmazonです"
        },
        {
          "turn_id": 8,
          "text": "ゲームソフトを買いましたね。よくやるので"
        },
        {
          "turn_id": 9,
          "text": "歯磨き粉ですか。マツキヨが近くにあるので通販では買わないですね"
        },
        {
          "turn_id": 10,
          "text": "なるほど、ただ必要以上に歯を削ってしまうものもあるので有名なメーカーじゃないと買わないですね"
        },
        {
          "turn_id": 11,
          "text": "ホワイトニングを歯科医院でするのは高いですからね。"
        },
        {
          "turn_id": 12,
          "text": "芸能人の方はお金をかけてるんだなと感じますね。"
        },
        {
          "turn_id": 13,
          "text": "凄いですよね、毎週くらいの頻度で行っているんだと思います"
        },
        {
          "turn_id": 14,
          "text": "テレビに映る仕事も大変ですね。"
        },
        {
          "turn_id": 15,
          "text": "美容が肝心な職業ですからね。"
        }
      ]
    },
    {
      "dialogue": "D11",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "今日、お散歩に出たら新しいコンビニができてたんですよ。"
        },
        {
          "turn_id": 2,
          "text": "ローソンです。"
        },
        {
          "turn_id": 3,
          "text": "オープンセールで、からあげくんが50円引きだったので買っちゃいました。"
        },
        {
          "turn_id": 4,
          "text": "私も好きです。特にチーズが好きです。"
        },
        {
          "turn_id": 5,
          "text": "瀬戸内レモンみたいな名前でしたっけ。からあげレモンは鉄板ですよね！"
        },
        {
          "turn_id": 6,
          "text": "お気に入りのコンビニとかありますか？"
        },
        {
          "turn_id": 7,
          "text": "セブンもいいですよね。サンドイッチが好きです。"
        },
        {
          "turn_id": 8,
