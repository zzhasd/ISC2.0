{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "そうですね。こちらも曇り時々雨ですね。台風が近づいてるとか。"
        },
        {
          "turn_id": 3,
          "text": "結構勢力が強そうですよね。実家付近に上陸する可能性があるので心配です。"
        },
        {
          "turn_id": 4,
          "text": "ですね。何か災害に向けて備蓄とかされてますか？"
        },
        {
          "turn_id": 5,
          "text": "避難バッグお持ちなんですね！全く何もしていないよりは、随分と準備されている方だと思います。"
        },
        {
          "turn_id": 6,
          "text": "確かに、一度中身は確認してもいいかもしれませんね。使い方もチェック必要かもですね。"
        },
        {
          "turn_id": 7,
          "text": "あ、寝るときのアイテムとかですかね？"
        },
        {
          "turn_id": 8,
          "text": "キャンプは全然なんですよ。でもキャンプグッズには興味あるので、色々調べてみようかなと。"
        },
        {
          "turn_id": 9,
          "text": "ご家族でキャンプ！いいですね、いい思い出になると思います。火起こしとか大変そうですよね。"
        },
        {
          "turn_id": 10,
          "text": "経験詰むまではチャッカマンとかでサクッと火起こししちゃってもいいと思いますよ！"
        },
        {
          "turn_id": 11,
          "text": "経験ないくせに偉そうにすみません！キャンプ系の動画とか見たりされますか？"
        },
        {
          "turn_id": 12,
          "text": "私はキャブヘイさんっていう方のYouTube動画よく観ます。おすすめですー！"
        },
        {
          "turn_id": 13,
          "text": "1人でされてますね。バイクに荷物積んでキャンプされてます。自然のものの利用方法がすごいんです。"
        },
        {
          "turn_id": 14,
          "text": "いつかの動画では山買ったとかで、山の開拓されてましたね。木の棒とか石とか、なんでも利用されます。"
        },
        {
          "turn_id": 15,
          "text": "ぜひぜひー！いい声のお兄さんですよ！お話ありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "それが、コーヒーは体質に合わなくて。でも、香りがすごく好きなので、よかったらお話伺いたいです。"
        },
        {
          "turn_id": 3,
          "text": "そうなんです！胃が痛くなって。有機栽培のものだとならない可能性が高いのですね。"
        },
        {
          "turn_id": 4,
          "text": "なるほど、農薬的なものがついている可能性があると。"
        },
        {
          "turn_id": 5,
          "text": "いい情報聞けて嬉しいです。有機栽培のコーヒーってどこで購入されてますか？"
        },
        {
          "turn_id": 6,
          "text": "産地で酸っぱめだったり、香りが強かったりとか、色々あるって聞きますね。どんな味がお好きなんですか？"
        },
        {
          "turn_id": 7,
          "text": "いいですね、ミルクでまろやかに楽しめそうです。私も酸っぱいのは苦手です。"
        },
        {
          "turn_id": 8,
          "text": "植物性のミルク！初めて聞くワードです！"
        },
        {
          "turn_id": 9,
          "text": "へー！コーヒー屋さんで提供されるミルクってそんなに種類があるんですね！"
        },
        {
          "turn_id": 10,
          "text": "オートミールが好きでよく食べているのですが、オーツミルクってどんな感じですか？"
        },
        {
          "turn_id": 11,
          "text": "そうなんですね！オーツミルク買ってみようっと！オートミールもよく食べられてたんですね。"
        },
        {
          "turn_id": 12,
          "text": "スープの具のひとつになりますよね。私はインスタントとかクイックと呼ばれる種類が好きです。"
        },
        {
          "turn_id": 13,
          "text": "ですよねー！私は毎朝オーバーナイトオートミールが定番です！"
        },
        {
          "turn_id": 14,
          "text": "夜寝る前にお好きなミルク200mlとオートミールを入れ、朝にそれにフルーツとかはちみつ入れるだけ！"
        },
        {
          "turn_id": 15,
          "text": "めちゃくちゃ簡単ですー！ぜひ！ありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちはー！"
        },
        {
          "turn_id": 2,
          "text": "今日はやることはいっぱいですが、絶対今日やるべきことはないので、だらだらしちゃってますー。"
        },
        {
          "turn_id": 3,
          "text": "そうなんですよ。雨降ってるのにわざわざ買い物に行こうとも思えず。"
        },
        {
          "turn_id": 4,
          "text": "もともとインドアな人間なので、引きこもり最高ですー！お家時間って何されてますか？"
        },
        {
          "turn_id": 5,
          "text": "お菓子作りお好きなんてすごいですね！クッキーいいなー！あの、茶色と白のクッキー憧れます。"
        },
        {
          "turn_id": 6,
          "text": "型抜きも十分可愛いと思います！アイシングとか、動画でみて、すごーいと口開けてます。"
        },
        {
          "turn_id": 7,
          "text": "結婚式！パステルカラーのお花柄とかありそうです！"
        },
        {
          "turn_id": 8,
          "text": "いいですね！食べるのがもったいなくなりそうです！"
        },
        {
          "turn_id": 9,
          "text": "そんなにいい作品だったのですね。"
        },
        {
          "turn_id": 10,
          "text": "私は最近ゲームにはまってて。モンハンってご存知ですか？"
        },
        {
          "turn_id": 11,
          "text": "おー！今は最新作のアプデがきて、すごく賑わってるんですよー！"
        },
        {
          "turn_id": 12,
          "text": "ですね。私は3rdと今作しかやってないので、まだまだモンハン初心者です！"
        },
        {
          "turn_id": 13,
          "text": "確かに操作に慣れるまでが大変ですよね。何かゲームってされますか？"
        },
        {
          "turn_id": 14,
          "text": "なるほどー！今度11月にポケモンの新作出るみたいですよー！"
        },
        {
          "turn_id": 15,
          "text": "あります！剣盾やってました！フィールドが広くて散策楽しいです。"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちはー！"
        },
        {
          "turn_id": 2,
          "text": "映画はあんまりなのですが、ジュラシックワールド観たいなって思ってました！"
        },
        {
          "turn_id": 3,
          "text": "私もともと恐竜が好きなのですが、ジュラシックシリーズは最新の研究も反映されててすごいです。"
        },
        {
          "turn_id": 4,
          "text": "確かに、観ると夜中の物陰が怖くて眠れなくなりますよね。"
        },
        {
          "turn_id": 5,
          "text": "ぜひぜひ！初代から見直したら楽しいです。"
        },
        {
          "turn_id": 6,
          "text": "ですね！アマプラとかだったら何作かは見れた気がします！そちらはお好きな映画ありますか？"
        },
        {
          "turn_id": 7,
          "text": "エヴァ！新しい方は観れてないですが、昔のアニメと映画はチェックしました！"
        },
        {
          "turn_id": 8,
          "text": "わかります、あの、どこまで深読みすればいいんだっていう、視聴者置き去り感。でもそこがいい。"
        },
        {
          "turn_id": 9,
          "text": "私もやりますー！私はカヲル君推しなので、色々切なくなることが多いです。"
        },
        {
          "turn_id": 10,
          "text": "幸薄い系美少年が好きなもので、いつも幸せを願いつつ破滅へと向かう推しを眺めることに。"
        },
        {
          "turn_id": 11,
          "text": "そうなんです、その姿が美しくて。はっ、変態トークかましてしまった。すみません！"
        },
        {
          "turn_id": 12,
          "text": "新撰組！薄桜鬼しか知らないのですが、そういった系統でしょうか？"
        },
        {
          "turn_id": 13,
          "text": "沖田さんっ！私も号泣しましたっ！うわー！懐かしい！"
        },
        {
          "turn_id": 14,
          "text": "あれを泣かずにいられる人がいるのかー！ってなります。号泣もの、あの当時の乙ゲー多かったですよね。"
        },
        {
          "turn_id": 15,
          "text": "私も学生時代はいっぱい乙ゲーやったなぁ。お話ありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "ちょうどおやつの時間ですね。好きなおやつって何かありますか？"
        },
        {
          "turn_id": 3,
          "text": "私は、どっちか選べず両方かごに入れちゃうタイプですね。シャトレーゼは危険です。"
        },
        {
          "turn_id": 4,
          "text": "まずプリンなどの洋菓子チェックして、スコーン入れて、和菓子コーナーで季節ものを買って、と。"
        },
        {
          "turn_id": 5,
          "text": "バウムクーヘン買ったことないことに今気づきました！チェックします！"
        },
        {
          "turn_id": 6,
          "text": "三層になっているチーズケーキ！あの平べったいタルト系ではないということですね。"
        },
        {
          "turn_id": 7,
          "text": "私はタルトの方がお安いのでついつい追加で買っちゃってました。三層、チェックします！"
        },
        {
          "turn_id": 8,
          "text": "かりんとう饅頭、わかります。お値段手ごろだし、変わらない美味しさについ。"
        },
        {
          "turn_id": 9,
          "text": "沁みる美味しさですよねー。シャトレーゼ行きたくなってきました！"
        },
        {
          "turn_id": 10,
          "text": "私も万年ダイエットしてますが、チートデーも大事ですよね！"
        },
        {
          "turn_id": 11,
          "text": "ですです！我慢ばっかりはよくないです！鶏の胸肉ばかりは飽きます！"
        },
        {
          "turn_id": 12,
          "text": "ですねー。私は去年からちゃんとダイエットしようと思って、PFCバランスを考えはじめました。"
        },
        {
          "turn_id": 13,
          "text": "日本人はお米が好きだからどうしても多くなりがちですよね。"
        },
        {
          "turn_id": 14,
          "text": "美味しいものは脂質と糖質でできている、ですね。"
        },
        {
          "turn_id": 15,
          "text": "困ったなー。美味しく食べて、ダイエット頑張りましょうね！"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちわ。よろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "ですね、朝夕だけですが、ようやく涼しくなってきましたよね。"
        },
        {
          "turn_id": 3,
          "text": "あの暑さは異常でしたものね。この暑さでしたが、何か夏らしいことってされましたか？"
        },
        {
          "turn_id": 4,
          "text": "こちらはコロナの影響で、本当は旅行に行くつもりが、泣く泣く延期になりましたね。"
        },
        {
          "turn_id": 5,
          "text": "そちらの周りは大丈夫でしたか？誰か近しい方が感染してしまったとかありましたか？差支えなければですが。"
        },
        {
          "turn_id": 6,
          "text": "それは大変でしたね！こっちも遠方の親族が感染してしまいました。幸い軽かったですけれども。何か感染対策ってされてますか？"
        },
        {
          "turn_id": 7,
          "text": "私も同じ感じですね！ちなみに、PCR検査とかって受けたことあります？"
        },
        {
          "turn_id": 8,
          "text": "抗原検査キットは私やったことないんですよ。どんな感じなのですか？"
        },
        {
          "turn_id": 9,
          "text": "うわぉ、思ってた以上に大変そうなのですね。出来ればもうやりたくない感じですか？"
        },
        {
          "turn_id": 10,
          "text": "キットって幾らくらいしたのですか？大体で良いので。"
        },
        {
          "turn_id": 11,
          "text": "ちなみに、それって1回分でしょうか？"
        },
        {
          "turn_id": 12,
          "text": "ですね！やっぱりお高いんですね！本っ当にコロナにならないにこしたことは無いですね。懐が寒くなりそうです。"
        },
        {
          "turn_id": 13,
          "text": "同感です。都内には無料で検査できる施設もあるみたいなのですが、その辺はどうなのですかね。こちらは地方なので、わかりませんが。"
        },
        {
          "turn_id": 14,
          "text": "ドラッグストアとかでもやっているんですか！？それは知らなかったです。"
        },
        {
          "turn_id": 15,
          "text": "無料だとそうなりそうですね。いやはや、色々あるんですね。"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちわ。よろしくお願いしますね。"
        },
        {
          "turn_id": 2,
          "text": "何か得意なお料理とかはありますか？お菓子とかでもですが。"
        },
        {
          "turn_id": 3,
          "text": "カレー粉ですか！？市販のルーとかではなく、カレー粉に色々組み合わせる感じですか！？"
        },
        {
          "turn_id": 4,
          "text": "クミンですか。他にはどのようなスパイスを入れたりしますか？味付けとか。"
        },
        {
          "turn_id": 5,
          "text": "トマト缶は良く聞きますね。コーヒーを入れると味に深みが出ると聞きますが、やはり入れないと物足りないなと言う感じですか？"
        },
        {
          "turn_id": 6,
          "text": "なるほど。今まで市販のルーのみで、辛さが足りないなと思った時にガラムマサラを使う程度だったのですが、カレー粉から作るのも面白そうですね。"
        },
        {
          "turn_id": 7,
          "text": "是非作ってみますよ！他には何か得意なお料理とかはありますか？"
        },
        {
          "turn_id": 8,
          "text": "米粉って使ったことないんですよ。どうですか？結構小麦粉よりも使い勝手が良い感じですか？イメージで良いので。"
        },
        {
          "turn_id": 9,
          "text": "そうなんですね。クッキーにも米粉って使えるんですね。小麦粉のクッキーと明らかな違いとかってありました？"
        },
        {
          "turn_id": 10,
          "text": "なるほど。小麦粉は使い辛いのですね。となりますと、他の料理とかにも小麦粉は使い辛そうですね。ホワイトソースとかよく使うじゃないですか。"
        },
        {
          "turn_id": 11,
          "text": "旦那様もアレルギーだったのですか！？毎日の献立考えるのって、結構大変じゃないですか！？"
        },
        {
          "turn_id": 12,
          "text": "今はどんな感じで献立を考えられているのですか？ルーティーンで決めているとか、それとも、その日その日で考えるとかですか？"
        },
        {
          "turn_id": 13,
          "text": "こちらも適当にですね。どちらかと言うと、こちらは好き嫌いが多い家族なので、それはそれで考え物です。"
        },
        {
          "turn_id": 14,
          "text": "子供達は野菜全般、奥さんは挽肉以外の肉全般が駄目だったりします。"
        },
        {
          "turn_id": 15,
          "text": "細かくしたりカレーに入れたりはしたんですけどね、奴ら、目ざとく発見して避けるんですよ。敵は手強いです。"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちわ。よろしくお願いしますね。"
        },
        {
          "turn_id": 2,
          "text": "こっちも良い天気でした。なので、今日は家族で朝から出かけましたよ。"
        },
        {
          "turn_id": 3,
          "text": "ココスと言うファミレスで、朝食バイキングをやっていたので、朝から行って来ました。"
        },
        {
          "turn_id": 4,
          "text": "意外と種類はありますね。沢山食べ過ぎたのか、家族全員、未だにお腹が空いてないみたいです。"
        },
        {
          "turn_id": 5,
          "text": "ですね！多分、心のどこかで元を取ってやる！なーんて思っちゃうんですかね？"
        },
        {
          "turn_id": 6,
          "text": "ありますあります！野菜が高騰したりしていると、やたらとサラダバーを取る回数が増えたりしますよね。"
        },
        {
          "turn_id": 7,
          "text": "そして食べるだけ食べて、体重計に乗って後悔する。の繰り返しですよアタシは。"
        },
        {
          "turn_id": 8,
          "text": "私も[PERSON]さんのように自制出来れば良いのに。翌日も通常運転な感じですね。ダイエットは明日から教の信者ですので。"
        },
        {
          "turn_id": 9,
          "text": "あはは。美味しい物ってついつい食べ過ぎちゃいますものね。"
        },
        {
          "turn_id": 10,
          "text": "ちなみに、旅行では、どのような物を食べ過ぎたのですか？"
        },
        {
          "turn_id": 11,
          "text": "結構旅行とかって行かれるのですか？"
        },
        {
          "turn_id": 12,
          "text": "マグロ！良いですねぇ。コロナ問題が収束したらまた旅行に行きたい感じですか？"
        },
        {
          "turn_id": 13,
          "text": "もし行けるとしたら、何処に行きたいですか？"
        },
        {
          "turn_id": 14,
          "text": "海外ですか！？どこの国に住まわれていましたか？"
        },
        {
          "turn_id": 15,
          "text": "その辺のお話もいずれ、詳しく聞いてみたいですね。"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちわ。よろしくお願いしますね。"
        },
        {
          "turn_id": 2,
          "text": "昔は良く飲んでいましたね。4年くらい飲んでいませんが。"
        },
        {
          "turn_id": 3,
          "text": "いやいや、そんな立派な物ではなく、急性アルコール中毒と言う症状になり、救急車で搬送されたりして、大変恥ずかしい思いをしたので。"
        },
        {
          "turn_id": 4,
          "text": "幸い、現在は何ともないのですが、回復した直後はお酒の瓶を見るだけでも気分が悪くなってしまいました。そちらはお酒は飲まれますか？"
        },
        {
          "turn_id": 5,
          "text": "何かお好きな銘柄はあったりしますか？"
        },
        {
          "turn_id": 6,
          "text": "私も甘口の方が好きでしたね。お酒に合うおつまみとかもおいしいですよね！"
        },
        {
          "turn_id": 7,
          "text": "わかりますわかります！みんなで集まってワイワイ飲むのって楽しいですよね！"
        },
        {
          "turn_id": 8,
          "text": "私もお酒は飲まないですが、そう言う場に行くのは好きです！何ですかね。余計な気を使わなくても良いって雰囲気ですかね？"
        },
        {
          "turn_id": 9,
