{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "はい。男です。[PERSON]さんはどちらでしょうか？"
        },
        {
          "turn_id": 3,
          "text": "私も20代です！仕事中に片手間で今やってます。"
        },
        {
          "turn_id": 4,
          "text": "もう今日やることは終わっちゃったんですよ。あんまり忙しくなくて。"
        },
        {
          "turn_id": 5,
          "text": "広報みたいなことをやってます。ブログ書いたりとか企画したりとか。[PERSON]さんは何かやられてますか？"
        },
        {
          "turn_id": 6,
          "text": "退職！それはお疲れ様でした。営業の仕事はとても大変そう…"
        },
        {
          "turn_id": 7,
          "text": "大変だし難しい仕事ですよね…次はどんな仕事をやってみたいとかあるんですか？"
        },
        {
          "turn_id": 8,
          "text": "おお、いいですね！デザイン勉強されてるんですか？"
        },
        {
          "turn_id": 9,
          "text": "なるほど、いいじゃないですか！うまくいくよう応援してます！"
        },
        {
          "turn_id": 10,
          "text": "はい、もちろんです！"
        },
        {
          "turn_id": 11,
          "text": "あーそういう感じではなくて、会社のPR的な感じですね"
        },
        {
          "turn_id": 12,
          "text": "採用に今のところ力入れてて、内情が見えるように、入りたいと思ってもらえるような宣伝？をブログで。"
        },
        {
          "turn_id": 13,
          "text": "自社のPRですね。なので他にもデザイナーと相談してウェブサイトリニューアルしたりとかもやります。"
        },
        {
          "turn_id": 14,
          "text": "というわけでもなく…なんとなくこんな感じかなーと手探りで進めてる状態です。"
        },
        {
          "turn_id": 15,
          "text": "そろそろ2年ぐらい経ちますね。"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは、よろしくお願いします。"
        },
        {
          "turn_id": 2,
          "text": "趣味をお聞きしてもいいでしょうか？"
        },
        {
          "turn_id": 3,
          "text": "植物！どんなもの育ててるんですか？"
        },
        {
          "turn_id": 4,
          "text": "ゴムの木…日本で育てられるものなんですね。テレビでしか見たことないような"
        },
        {
          "turn_id": 5,
          "text": "へーそうなんですか。ポピュラーな植物なんですね！切ったら汁が出てくるイメージしかありませんでした…"
        },
        {
          "turn_id": 6,
          "text": "汁がゴムの原料になるってテレビで見たことがあります。傷つけなくても勝手に出るんですね。"
        },
        {
          "turn_id": 7,
          "text": "なるほど、そうなんですか！部屋の中で育ててるんですか？"
        },
        {
          "turn_id": 8,
          "text": "おお、オリーブも。オリーブって実が取れたりするんでしょうか？"
        },
        {
          "turn_id": 9,
          "text": "そうか、木ですもんね、大きくならないとなりませんよね…"
        },
        {
          "turn_id": 10,
          "text": "そういえば昔探偵ナイトスクープで一粒だけなった実でコーヒー淹れる話が。色々育ててるんですね。"
        },
        {
          "turn_id": 11,
          "text": "なんか色々覚えてるんですよ！それも亡くなったお父さんが大事に育ててた木から取れた実とかで"
        },
        {
          "turn_id": 12,
          "text": "ですです！いやいやそんなことは。出身は関西の方ですか？"
        },
        {
          "turn_id": 13,
          "text": "兵庫出身で今実家が大阪にあります！"
        },
        {
          "turn_id": 14,
          "text": "そうなんですか！私が就職してすぐに親が大阪に引っ越したんですよ。私は今東京に住んでるんですけどね"
        },
        {
          "turn_id": 15,
          "text": "中学生ぐらいからもう東京に出たくて出たくて。なんか憧れてたんですよね…"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こちらこそよろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "楽しいです！なぜか地元よりか全然落ち着きます！"
        },
        {
          "turn_id": 3,
          "text": "確かにそんなイメージありますね！でも人も優しいし今のところ快適です！"
        },
        {
          "turn_id": 4,
          "text": "大変でした…けどコロナでもう2年ぐらいずっとリモートなんですよ。楽々です！"
        },
        {
          "turn_id": 5,
          "text": "もう二度と通勤したくないですね…在宅で営業職ってどんな感じだったんですか？"
        },
        {
          "turn_id": 6,
          "text": "なるほど、営業は普通に行ってた感じなんですね。結局大変だ…本当にお疲れ様でした。"
        },
        {
          "turn_id": 7,
          "text": "なるほど！それだったらまあ。"
        },
        {
          "turn_id": 8,
          "text": "そうですねーもはやうちの会社はオフィスがなくなるかもしれません。ほとんど誰も出社してないですから…"
        },
        {
          "turn_id": 9,
          "text": "あんまり問題ないと思います。倉庫とか、ちょっとした作業スペースは借りる予定みたいですけど"
        },
        {
          "turn_id": 10,
          "text": "増えていきそうですね。借りてるだけ維持費がーとかいろんなとこで話聞きます。"
        },
        {
          "turn_id": 11,
          "text": "もうコロナかかったりしました？"
        },
        {
          "turn_id": 12,
          "text": "たしかに！私はこの前ついに罹ったんですけどしんどかったです…"
        },
        {
          "turn_id": 13,
          "text": "自分の場合は主に熱で、それ以外は特にって感じでした。2日ぐらいで元気になって。"
        },
        {
          "turn_id": 14,
          "text": "問題なしです！味覚なくなったらやだなーと思ってたんですけど何もなくてよかったです！"
        },
        {
          "turn_id": 15,
          "text": "ですよね、、、三回目を打つ直前になっちゃったんですよ"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "今は一人暮らしですか？"
        },
        {
          "turn_id": 3,
          "text": "なるほど、今は彼女と一緒に住んでます"
        },
        {
          "turn_id": 4,
          "text": "もう3年ぐらいになるんですけど、その状態が当たり前みたいになっちゃいましたね"
        },
        {
          "turn_id": 5,
          "text": "うーん、まあ仲はいいと思います！"
        },
        {
          "turn_id": 6,
          "text": "あらあらそれは、、、6年って相当長い。結婚するかどうか考えるぐらいの感じですよね"
        },
        {
          "turn_id": 7,
          "text": "なるほど…それは難しいところです。相手の方は結婚したくなかったんですかね"
        },
        {
          "turn_id": 8,
          "text": "ならよかった！いい出会いがあるといいですね！"
        },
        {
          "turn_id": 9,
          "text": "あー、友達もよく街コンとかマッチングアプリとかですごく頑張ってる印象です。"
        },
        {
          "turn_id": 10,
          "text": "ごくごく簡単に説明したら友達の友達です！元々はそれを知らずで知り合ったんですが"
        },
        {
          "turn_id": 11,
          "text": "よいですよ！"
        },
        {
          "turn_id": 12,
          "text": "いえ全然。むしろ彼女からの猛アタックで、じゃあ付き合いますかってなった感じでして…"
        },
        {
          "turn_id": 13,
          "text": "全然モテませんよ、たまたま今の彼女には刺さっただけで。うーん、まあそうですね"
        },
        {
          "turn_id": 14,
          "text": "まあゆくゆくは。最近彼女が仕事辞めちゃって無職なので、ちょっと落ち着くまではなーと思っています。"
        },
        {
          "turn_id": 15,
          "text": "ありがとうございます！sakaiさんもいい恋人できるといいですね"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "お願いします！"
        },
        {
          "turn_id": 2,
          "text": "もちろんです！よくある感じですが、ネトフリみたりゲームしたり音楽聴いたり本読んだりのインドアです"
        },
        {
          "turn_id": 3,
          "text": "町田高って人がすごい好きです。元々バンドやってた人でバンドが好きだったんですけど"
        },
        {
          "turn_id": 4,
          "text": "まだ現役で活動はしてますが、もう60歳とかですね。そして漢字間違えてた…町田康でした"
        },
        {
          "turn_id": 5,
          "text": "そうですね、ここ何年間かの勢いがわりとすごくて。好きな作家さんとかおられますか？"
        },
        {
          "turn_id": 6,
          "text": "おお、筒井康隆自分も好きです！町田康も元々は筒井康隆のファンで。面白いのは夫婦茶碗が読みやすいかなと"
        },
        {
          "turn_id": 7,
          "text": "わかります！個人的には「あるいは酒でいっぱいの海」が一番好きかも。夫婦茶碗は映画にはなってないですね"
        },
        {
          "turn_id": 8,
          "text": "ハードボイルド感は全くないかも。基本自堕落で自虐的で不条理ですね"
        },
        {
          "turn_id": 9,
          "text": "よかったら読んでみてください！急流、載ってる本は持ってるので読んだことあるんでしょうけど内容が…"
        },
        {
          "turn_id": 10,
          "text": "覚えがあるようなないような。。。うーんもう一回読んでみます！"
        },
        {
          "turn_id": 11,
          "text": "あー友人に勧められて何冊か積読しています！"
        },
        {
          "turn_id": 12,
          "text": "しかも最近引っ越したところなのでどこにあるかわからないという。ちなみにおすすめはありますか？"
        },
        {
          "turn_id": 13,
          "text": "こじらせてて悪魔的！魅力的なワードです。それは是非とも読んでみようと思います。短編でしょうか？"
        },
        {
          "turn_id": 14,
          "text": "なるほど！それぐらいならすぐ読めそうですね！早速買ってみます"
        },
        {
          "turn_id": 15,
          "text": "そうですね、古い人ですが織田作之助とかも面白いですよ"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いしますー！"
        },
        {
          "turn_id": 2,
          "text": "仕事しながらなので全然大丈夫です。むしろ大丈夫ですか？"
        },
        {
          "turn_id": 3,
          "text": "それはよかった！何みられてるんですか？"
        },
        {
          "turn_id": 4,
          "text": "登録してます！アマプラとネトふりとdアニメは入ってますね"
        },
        {
          "turn_id": 5,
          "text": "そうですね、アニメも見ますね。最近は謎にタッチをずっとみてました"
        },
        {
          "turn_id": 6,
          "text": "あーいいですね、面白いしちょうどいい感じのアニメをずーっと流しながらゴロゴロ流し見するのが好きです。"
        },
        {
          "turn_id": 7,
          "text": "攻殻機動隊ですか？"
        },
        {
          "turn_id": 8,
          "text": "結構前に見ました！なんかめちゃくちゃ細部まで作り込まれててすごかった印象"
        },
        {
          "turn_id": 9,
          "text": "もしかしたら映画の前作を見ておいた方が話はわかるかもだったような…"
        },
        {
          "turn_id": 10,
          "text": "特にイノセンスは難解だった気がします。途中から再開してる感じですか？"
        },
        {
          "turn_id": 11,
          "text": "でもあんまり話に繋がりないらしいので、そこから見ても大丈夫そう。"
        },
        {
          "turn_id": 12,
          "text": "じっくりコンプリートしてください！"
        },
        {
          "turn_id": 13,
          "text": "あーこの前途中まで見ました！流し見してたんですけどこれはちゃんと見ないとダメなやつだと思いストップ中"
        },
        {
          "turn_id": 14,
          "text": "いえいえ、色々流し見してるだけです！メトロポリスは映像がすごくてどこも見逃せないというか"
        },
        {
          "turn_id": 15,
          "text": "ぜひぜひお気軽にお尋ねください！"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "今日の晩御飯はなんですか？"
        },
        {
          "turn_id": 3,
          "text": "なるほど、ご自身でつくられるんですか？？"
        },
        {
          "turn_id": 4,
          "text": "そうなんですね、そろそろ晩御飯どうしようかなーと考えていて。"
        },
        {
          "turn_id": 5,
          "text": "最近は外食が多いですね、、もっと自炊したいんですが"
        },
        {
          "turn_id": 6,
          "text": "めちゃ多いです。とは言ってもほとんど飲み屋ですが、、チェーン店も多いのでサクッと済ましちゃう感じです"
        },
        {
          "turn_id": 7,
          "text": "お食事はほとんど自宅ですか？"
        },
        {
          "turn_id": 8,
          "text": "実家でもなんかご飯出てくる感じではないんですね"
        },
        {
          "turn_id": 9,
          "text": "なるほど、切ない…。"
        },
        {
          "turn_id": 10,
          "text": "笑いました！大体ずっと家にいるんですか？"
        },
        {
          "turn_id": 11,
          "text": "なるほど、自分もずっとリモートなんで運動不足で。。リングフィットやるようにしてます"
        },
        {
          "turn_id": 12,
          "text": "ですね！もうそろそろ始めて一年になるんですが、健康診断の数値は良くなりました！"
        },
        {
          "turn_id": 13,
          "text": "思ってたのと違って無駄に筋肉がついてしまったので、、最近は週三ぐらいに減らして自転車に乗ってます。"
        },
        {
          "turn_id": 14,
          "text": "体のサイズがデカくなったんですよね。ただ痩せたかっただけなのにこれは違うと。結局自然体が一番ですよ"
        },
        {
          "turn_id": 15,
          "text": "食生活の見直しが必要です。。でも好きなものを好きなだけ食べたい欲求が、、、"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "自炊で適量好きなもの、、自炊だと作りすぎちゃうんですよね。おかわりもできるし"
        },
        {
          "turn_id": 3,
          "text": "食べたり食べなかったりですけど、大体同じぐらい食べる気が。二人とも食べるの好きなんですよね"
        },
        {
          "turn_id": 4,
          "text": "麻婆豆腐が好きです！何が好きですか？"
        },
        {
          "turn_id": 5,
          "text": "あーグリーンカレーも好きです！タイ料理とかベトナム料理もいいですよね。。。"
        },
        {
          "turn_id": 6,
          "text": "パクチーは育てたりしてないんですか？"
        },
        {
          "turn_id": 7,
          "text": "なるほど、育てるのって難しいですか？"
        },
        {
          "turn_id": 8,
          "text": "そうなんですね。食べれる植物を育ててみたいんですけど虫とかって大変ですか？"
        },
        {
          "turn_id": 9,
          "text": "あー、なんかそれ聞いたことあります！ベランダの日当たりがそんなに良くないんですけど大丈夫ですかね"
        },
        {
          "turn_id": 10,
          "text": "なるほど、聞いてみようと思います。そしてバジルを育てたいです。"
        },
        {
          "turn_id": 11,
          "text": "最近インスタでイタリア人が料理してる動画をおすすめされるのですが、庭に生えてるバジルを使ってるんです"
        },
        {
          "turn_id": 12,
          "text": "いいですよね、美味しそうだし。はい、検討してみます！"
        },
        {
          "turn_id": 13,
          "text": "確かに！でもいろんな植物育ててるんですね"
        },
        {
          "turn_id": 14,
          "text": "すげー、そんなに植物が、、"
        },
        {
          "turn_id": 15,
          "text": "庭はあるんですか？"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "いえいえ、イカ墨パスタいいですね。。まだ一度も食べたことがない料理です"
        },
        {
          "turn_id": 3,
          "text": "そうなんですね、実は最近まで甲殻類アレルギーだと思ってて食べたことがなかったんですよ"
        },
        {
          "turn_id": 4,
          "text": "はい、アレルギー検査をして。"
        },
        {
          "turn_id": 5,
          "text": "そうなんです！20年ぐらい食べてなかったんです。その分今食べてます！"
        },
        {
          "turn_id": 6,
          "text": "はい！エビまよが美味しかったですね。あとカニの刺身？みたいなのが美味しかったです"
        },
        {
          "turn_id": 7,
          "text": "ですよね、なのでずっとこれまではツナマヨしか食べてきませんでした。エビ美味しい"
        },
        {
          "turn_id": 8,
          "text": "まだです！終わったら何か作ろうかと！"
        },
        {
          "turn_id": 9,
          "text": "いえいえ、もうすこしですし！"
        },
        {
          "turn_id": 10,
          "text": "仕事はもう上がりました！今日も特に何もなく、平和な1日でした。そちらはどうでしたか？"
        },
        {
          "turn_id": 11,
          "text": "室内に出たんですか？"
        },
        {
          "turn_id": 12,
          "text": "首に！それは恐ろしい。カメムシ臭いですよね。きゅうりみたいな匂い"
        },
        {
          "turn_id": 13,
          "text": "それはお風呂に入らないと。うまく外に逃がせましたか？"
        },
        {
          "turn_id": 14,
          "text": "なるほど。やはり植物と虫は切り離せませんね。。"
        },
        {
          "turn_id": 15,
          "text": "虫苦手です"
        }
      ]
    },
    {
      "dialogue": "D10",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "それでは最後よろしくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "いやーほんと虫が苦手で。クワガタとかなら触れるんですけどね"
        },
        {
          "turn_id": 3,
          "text": "自分も育ててました。山奥まで取りに行って。もう今飼おうとは思いませんが"
        },
        {
          "turn_id": 4,
          "text": "たしかに。幼虫はもう触れない。"
        },
        {
          "turn_id": 5,
