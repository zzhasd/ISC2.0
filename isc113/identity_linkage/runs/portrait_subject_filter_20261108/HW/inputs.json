{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！よろしくお願いしますー。"
        },
        {
          "turn_id": 2,
          "text": "もうお昼は済まされましたか？"
        },
        {
          "turn_id": 3,
          "text": "まだ食べられてないんですね！朝からバタバタでしたか？"
        },
        {
          "turn_id": 4,
          "text": "そうだったんですね！私はさっきまでうどんを食べてました。"
        },
        {
          "turn_id": 5,
          "text": "そうですね！シーチキン缶に市販のたれをかけただけの簡単なやつです。"
        },
        {
          "turn_id": 6,
          "text": "私もそれです！ゆず塩味！"
        },
        {
          "turn_id": 7,
          "text": "ですです！あれが一番おいしいです。楽だし。同志がいて嬉しいですー。"
        },
        {
          "turn_id": 8,
          "text": "たしかに具をちゃんと入れると足りなくなるんですよね。"
        },
        {
          "turn_id": 9,
          "text": "二つ入れるとは豪快ですね！旦那さんですか？"
        },
        {
          "turn_id": 10,
          "text": "弟くんでしたか！まあ夏は塩分も必要ですからね。"
        },
        {
          "turn_id": 11,
          "text": "最近は特に暑いですからね！昔はこんなじゃなかった気がします。"
        },
        {
          "turn_id": 12,
          "text": "夏休みも普通に外で遊んでましたからねえ。命の危機を感じたことはなかったです。"
        },
        {
          "turn_id": 13,
          "text": "クーラーも生命維持装置ですもんね。"
        },
        {
          "turn_id": 14,
          "text": "電気代が痛すぎるーって、いつも言ってます。"
        },
        {
          "turn_id": 15,
          "text": "去年より電気代が5000円も上がりました！悲しいです。"
        },
        {
          "turn_id": 16,
          "text": "はい！少しは節約しなきゃ。どうもありがとうございました。"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "今日も暑いですね。さっきゴミを出しに外に出て驚きました。"
        },
        {
          "turn_id": 3,
          "text": "分かります！北海道に友人がいるんですが、その友人も音を上げてましたからね。"
        },
        {
          "turn_id": 4,
          "text": "北海道に行かれたんですね！私も一度だけ行ったことがあります。"
        },
        {
          "turn_id": 5,
          "text": "私は雪まつりの時期に行きました。８月の北海道、どこに行かれたんですか？"
        },
        {
          "turn_id": 6,
          "text": "すごい長距離を巡りましたね！小樽は私も行きました。小樽のワインが絶品でした。"
        },
        {
          "turn_id": 7,
          "text": "北海道の海鮮丼は最高ですよね。死ぬまでにもう１度食べたいです。大袈裟でなく。"
        },
        {
          "turn_id": 8,
          "text": "ね！イカって本当、イカによって味が全然違うので驚きます。旅行お好きなんですか？"
        },
        {
          "turn_id": 9,
          "text": "景色を見るのがお好きなんですね。これまで見た景色の中で、最高のものと言えば？"
        },
        {
          "turn_id": 10,
          "text": "それは車を運転していても気持ちよかったでしょうね！私の行った時期はどこもかしこも雪で通行止めばかりを心配してましたよ。"
        },
        {
          "turn_id": 11,
          "text": "雪まつりでなく雪めあてで来られる方もいるんですね！知りませんでした。"
        },
        {
          "turn_id": 12,
          "text": "雪まつりは見ましたよ！写真２００枚ぐらい撮りました。"
        },
        {
          "turn_id": 13,
          "text": "滑りました！結構ちゃんと滑れるんですね、あれ。"
        },
        {
          "turn_id": 14,
          "text": "私は今度、夏の北海道にも行ってみたいですねー。"
        },
        {
          "turn_id": 15,
          "text": "今日は楽しいお話をありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "何てお呼びすれば良いですか？私は[PERSON]とお呼びください。"
        },
        {
          "turn_id": 3,
          "text": "めちゃくちゃ笑いました！スキヤキと猫がお好きなんですか？"
        },
        {
          "turn_id": 4,
          "text": "好きなものを名前にしてる人は多いですけど、合体させてる人は珍しいですね。面白いです。"
        },
        {
          "turn_id": 5,
          "text": "好物を並べるという発想力が羨ましいです！私の[PERSON]は、なんというか、そのままです。"
        },
        {
          "turn_id": 6,
          "text": "困らせてしまって、すいません！何も思いつかなかったんですよね。猫は飼ってらっしゃる？"
        },
        {
          "turn_id": 7,
          "text": "猫好きなのにアレルギーって人、多い気がします！確かにトホホですね。二大好物のひとつなのに。"
        },
        {
          "turn_id": 8,
          "text": "本気で好きじゃないですか！ちなみに三大好物にすると、あと１つは何が入るんです？"
        },
        {
          "turn_id": 9,
          "text": "音楽良いですね！どんなものを聞かれるんですか？"
        },
        {
          "turn_id": 10,
          "text": "私はそういうの全然疎くって。でも米津玄師は好きで良く聞きますね。"
        },
        {
          "turn_id": 11,
          "text": "私はホント最近なんですけどね。シンウルトラマンの主題歌だったと思うんですが、あれ聞いた時泣いちゃって。"
        },
        {
          "turn_id": 12,
          "text": "映画行ってないんですよー！ウルトラマン知らなくても楽しめるのかな？[PERSON]さんは行きました？"
        },
        {
          "turn_id": 13,
          "text": "あ、さっきＭＶだけって言ってましたもんね。すいません。マーベリックは楽しかったですか？"
        },
        {
          "turn_id": 14,
          "text": "ああいうのはやっぱり映画館で見てこそですね！"
        },
        {
          "turn_id": 15,
          "text": "感動が全然違ってきますもんね。今日はありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちはー！"
        },
        {
          "turn_id": 2,
          "text": "最近、よくＴＵＴＡＹＡに行くんですけど、おすすめ映画とかってあります？"
        },
        {
          "turn_id": 3,
          "text": "一度だけ映画館で見ました！確かに面白かったです！"
        },
        {
          "turn_id": 4,
          "text": "ジョニー・デップ良いですよね！私のような映画に疎い人でもあの人の演技が突出してることは分かりますよ。"
        },
        {
          "turn_id": 5,
          "text": "今度借りてきます！パイレーツオブカリビアンの中で一番のオススメは？何作かあるんですよね。"
        },
        {
          "turn_id": 6,
          "text": "調べれば分かると思います！どうもありがとうございます！楽しみです。"
        },
        {
          "turn_id": 7,
          "text": "昔の映画なんですが「Ａ．Ｉ．」にはめちゃくちゃ泣かされましたね。"
        },
        {
          "turn_id": 8,
          "text": "そうです！あとは月並みなんですが、タイタニックにも泣きました。"
        },
        {
          "turn_id": 9,
          "text": "「Ａ．Ｉ．」観られてたんですね！タイタニックは同意を得られやすいんですが「Ａ．Ｉ．」はそうでもなかったので嬉しいです。"
        },
        {
          "turn_id": 10,
          "text": "そうです！ラストが予想を大きく越えてきて！一緒に観てた人にドン引きされるほど泣きましたね。"
        },
        {
          "turn_id": 11,
          "text": "私は成人してから見ました。今は子供がいるので、見たら泣きすぎて干上がると思います。観られませんね、、"
        },
        {
          "turn_id": 12,
          "text": "最近は映画でもなんでもネットの感想込みで楽しめちゃいますよね。"
        },
        {
          "turn_id": 13,
          "text": "そうなんですよ！自分にはなかった着眼点に気付かされたりするのもメリットですよね。"
        },
        {
          "turn_id": 14,
          "text": "自分が言いたかったことを、もっと上手く言葉にしている人がいて悔しくなる、なんていうのも良い経験です。"
        },
        {
          "turn_id": 15,
          "text": "その通りですね！分かります！今日はありがとうございました。"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "[PERSON]さんは、今ハマってることとかありますか？"
        },
        {
          "turn_id": 3,
          "text": "フレンチトースト！うまく作るコツなどはありますか？"
        },
        {
          "turn_id": 4,
          "text": "え、自動で作ってくれるんですか？フレンチトーストを！？"
        },
        {
          "turn_id": 5,
          "text": "すごい！ハイテク！火加減の調整をしなくていいのは素晴らしいですね。"
        },
        {
          "turn_id": 6,
          "text": "私もフレンチトーストは生っぽくなっちゃう派でした！他にもＩＨ調理器で自動で作れるものはありますか？"
        },
        {
          "turn_id": 7,
          "text": "欲しくなってきたー！けっこうスペースは必要だったりしますか？"
        },
        {
          "turn_id": 8,
          "text": "ありがとうございます！ガスコンロと違って目を離せるのも良いですね。自分でも調べてみます。"
        },
        {
          "turn_id": 9,
          "text": "タイマーですか！やっぱりスマホでタイマー使うのとは違います？"
        },
        {
          "turn_id": 10,
          "text": "えっ、あっ、そうか、タイマーと言っても時間を計ってくれるやつではないのですね。"
        },
        {
          "turn_id": 11,
          "text": "一目で分かるってやつですね！それは便利だ。私はせっかちなのでいつも半茹でにしてしまうんですよ。"
        },
        {
          "turn_id": 12,
          "text": "半熟以前だと皮を剥く時に中身が出てきてしまいますからね！あれはよくない。"
        },
        {
          "turn_id": 13,
          "text": "フレンチトーストといい、ゆで卵といい、私もそうですがせっかちさんにありがたいものが、あるわけですね！"
        },
        {
          "turn_id": 14,
          "text": "たくさん買ってますね！でも時短大事！"
        },
        {
          "turn_id": 15,
          "text": "今日は有益な情報をたくさんありがとうございました！明日１００均行く用事があるので早速見てきます。"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "本当に暑いですね〜"
        },
        {
          "turn_id": 3,
          "text": "いいですね〜！アイス食べまくりです"
        },
        {
          "turn_id": 4,
          "text": "バニラかな〜スキヤキキャットさんは？"
        },
        {
          "turn_id": 5,
          "text": "わあ！抹茶アイスいいですよね！"
        },
        {
          "turn_id": 6,
          "text": "パルムの抹茶味まだ食べたことないので聞きながら食べたくなりました"
        },
        {
          "turn_id": 7,
          "text": "次アイス買うとき食べて見ます！"
        },
        {
          "turn_id": 8,
          "text": "アイスつながりで、この間かき氷を食べに行ったら面白いかき氷がありました"
        },
        {
          "turn_id": 9,
          "text": "ティラミスのかき氷なんです"
        },
        {
          "turn_id": 10,
          "text": "食べる前は、どんなかなと思ったのですが、食べたら本当にしっかりティラミスの味でした"
        },
        {
          "turn_id": 11,
          "text": "上にクリームが乗っかっているような感じで、ココアがまぶしてある感じでした。"
        },
        {
          "turn_id": 12,
          "text": "県外からもお客さんが足を運ぶらしいです"
        },
        {
          "turn_id": 13,
          "text": "かき氷はどこも一緒だと思っていましたが、行って見てならぶ理由がわかりました"
        },
        {
          "turn_id": 14,
          "text": "なりますね"
        },
        {
          "turn_id": 15,
          "text": "ぜひぜひ！ありがとうございました！"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "私は布団派です。[PERSON]さんは？"
        },
        {
          "turn_id": 3,
          "text": "お！いいですね〜なぜ二段ベッドに？"
        },
        {
          "turn_id": 4,
          "text": "そういう使い方もあるんですね！"
        },
        {
          "turn_id": 5,
          "text": "インテリアの知恵[PERSON]さんにいろいろ教えていただきたいです"
        },
        {
          "turn_id": 6,
          "text": "転がって出る技、最高ですね"
        },
        {
          "turn_id": 7,
          "text": "確かにそういう動作が増えますね"
        },
        {
          "turn_id": 8,
          "text": "あははは　あと数秒だったんですね"
        },
        {
          "turn_id": 9,
          "text": "そうか…熱い空気上に行きますものね。こりゃ大変だ"
        },
        {
          "turn_id": 10,
          "text": "本当に。冷房ないともう無理ですね"
        },
        {
          "turn_id": 11,
          "text": "夜も使ってます。窓を開けてもとても暑くて。[PERSON]さんは？"
        },
        {
          "turn_id": 12,
          "text": "うわああ　涼しいけど別の意味で辛いですね"
        },
        {
          "turn_id": 13,
          "text": "下段で寝ちゃうとかはどうでしょう"
        },
        {
          "turn_id": 14,
          "text": "上が荷物だと不安定になっちゃいますもんね"
        },
        {
          "turn_id": 15,
          "text": "ぐっすり眠れますように。またお話ししましょう！"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "ラーメンです！いろんなお店に食べに行くのが好きです。[PERSON]さんは？"
        },
        {
          "turn_id": 3,
          "text": "醤油がいちばん好きです。お寿司もいいなあ！！！"
        },
        {
          "turn_id": 4,
          "text": "ここのお店が好き！!とかってありますか？"
        },
        {
          "turn_id": 5,
          "text": "行ってみたいです！神奈川のお店ではないですか？"
        },
        {
          "turn_id": 6,
          "text": "全国展開のお店なんですね！そしたら近くにあるかもしれない！探してみます！"
        },
        {
          "turn_id": 7,
          "text": "ラ王にゆず塩味があったのはじめて知りました！お店でゲットしてきます！"
        },
        {
          "turn_id": 8,
          "text": "期間限定だったんですね。確かにゆずは冬ですものね。"
        },
        {
          "turn_id": 9,
          "text": "塩ラーメンが食べたくなってきました"
        },
        {
          "turn_id": 10,
          "text": "コロナ禍でなければ、日本のいろいろなラーメン屋さんに足を運んでみたいです"
        },
        {
          "turn_id": 11,
          "text": "わあ！それいいですね！"
        },
        {
          "turn_id": 12,
          "text": "上位のお店って、やっぱり東京とかなんですかね"
        },
        {
          "turn_id": 13,
          "text": "東京が逆に支店なんですね。ラーメンもだけど親方がどんな方なのかも見てみたいかもです"
        },
        {
          "turn_id": 14,
          "text": "なるほど！親方はそういうとこでも確認できますね"
        },
        {
          "turn_id": 15,
          "text": "確かにありがたい世の中ですね。またお話ししましょう！"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちわ"
        },
        {
          "turn_id": 2,
          "text": "コーヒーが大好きです。お酒だと焼酎と日本酒です。[PERSON]さんは？"
        },
        {
          "turn_id": 3,
          "text": "紅茶もいいですよね。そしてノンカフェインとても興味があります！"
        },
        {
          "turn_id": 4,
          "text": "カフェイン取りすぎは良くないと聞いて、最近カフェイン控えたものを考えていて"
        },
        {
          "turn_id": 5,
          "text": "コーヒーはもっぱらインスタントでブラックなのですが、最近気づいたお気に入りの飲み方があります"
        },
        {
          "turn_id": 6,
          "text": "コーヒーは好みのブラックのままなのですが、一緒に食べるものを、ホワイトチョコレートにするんです"
        },
        {
          "turn_id": 7,
          "text": "甘さと、ミルク感と、ホワイトチョコがあれば楽しめるのでオススメです"
        },
        {
          "turn_id": 8,
          "text": "しかしカフェインって胃にくるんですね"
        },
        {
          "turn_id": 9,
          "text": "体が教えてくれてるんですね"
        },
        {
          "turn_id": 10,
          "text": "デカフェとノンカフェイン一緒の意味だったんですね！"
        },
        {
          "turn_id": 11,
          "text": "万人にいいんですね"
        },
        {
          "turn_id": 12,
          "text": "そういえば、話が変わってしまうのですが、もしかして猫を飼われていたりしますか？"
        },
        {
          "turn_id": 13,
          "text": "そうだったんですね！スラックのアイコンが可愛い猫ちゃんだったので。猫癒されますよね"
        },
        {
          "turn_id": 14,
          "text": "想像しただけで癒されます"
        },
        {
          "turn_id": 15,
          "text": "もちねこ、もち様ですか！？私も大好きです！またお話ししましょう！"
        }
      ]
    },
    {
      "dialogue": "D10",
      "partner": "A3",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "初めまして、宜しくお願いします！"
        },
        {
          "turn_id": 2,
          "text": "実は運動音痴でして、でも泳ぐのは好きです。そちらはどうです？"
        },
        {
          "turn_id": 3,
          "text": "テニスかっこいい！紳士のスポーツと言われるやつですよ。"
        },
        {
          "turn_id": 4,
          "text": "夏にするには暑すぎて倒れそうですねぇ。ハードに動くし。"
        },
        {
          "turn_id": 5,
          "text": "近所の市民プールに子供といったぐらいです。ほんとは今日は川に行く予定だったんですが。"
        },
        {
          "turn_id": 6,
          "text": "コロナの関係もあってそんなには混んでなかったので良かったです。"
        },
        {
          "turn_id": 7,
          "text": "貸し切りプールなんて、なんて羨ましい！！"
        },
        {
          "turn_id": 8,
          "text": "すごーい！朝一って8時くらいです？"
        },
        {
          "turn_id": 9,
