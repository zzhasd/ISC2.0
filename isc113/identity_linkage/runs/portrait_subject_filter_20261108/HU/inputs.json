{
  "dialogues": [
    {
      "dialogue": "D1",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは！"
        },
        {
          "turn_id": 2,
          "text": "今日は何をしていましたか？"
        },
        {
          "turn_id": 3,
          "text": "優雅な休日ですね！"
        },
        {
          "turn_id": 4,
          "text": "今日は一日競馬を見てました。"
        },
        {
          "turn_id": 5,
          "text": "はい！"
        },
        {
          "turn_id": 6,
          "text": "普通にスポーツとしても面白いですよ。"
        },
        {
          "turn_id": 7,
          "text": "馬の性格とかも全然違うので面白いです。"
        },
        {
          "turn_id": 8,
          "text": "ソダシっていう馬が白馬で美しいので好きです！"
        },
        {
          "turn_id": 9,
          "text": "とても珍しいのでものすごく目立ちます。"
        },
        {
          "turn_id": 10,
          "text": "スポーツ観戦とかしますか？"
        },
        {
          "turn_id": 11,
          "text": "何をよく見ますか？"
        },
        {
          "turn_id": 12,
          "text": "お父さんはどこのファンでした？"
        },
        {
          "turn_id": 13,
          "text": "昔はよく巨人戦テレビでやってましたもんね！"
        },
        {
          "turn_id": 14,
          "text": "私もよく父と喧嘩をしていました。"
        },
        {
          "turn_id": 15,
          "text": "今はネットもあるのでそういう光景は少なくなってそうですね。"
        }
      ]
    },
    {
      "dialogue": "D2",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは。"
        },
        {
          "turn_id": 2,
          "text": "秋が一番好きです！"
        },
        {
          "turn_id": 3,
          "text": "食べ物が美味しいのと、気温がちょうどいいかなと。"
        },
        {
          "turn_id": 4,
          "text": "あと春は花粉症がひどくて。"
        },
        {
          "turn_id": 5,
          "text": "もう体の水全部抜きたいくらい鼻水出ます。"
        },
        {
          "turn_id": 6,
          "text": "あなたは花粉症はないですか？"
        },
        {
          "turn_id": 7,
          "text": "めっちゃ羨ましいです！"
        },
        {
          "turn_id": 8,
          "text": "アレルギーとかもないですか？"
        },
        {
          "turn_id": 9,
          "text": "私は蕎麦アレルギーもあるので大変です。"
        },
        {
          "turn_id": 10,
          "text": "知らないうちに食べちゃって病院送りになったこともあります。"
        },
        {
          "turn_id": 11,
          "text": "蕎麦は特に命に関わるらしいです。"
        },
        {
          "turn_id": 12,
          "text": "私と一緒だ！"
        },
        {
          "turn_id": 13,
          "text": "とりあえずそれ以来、外食では疑わしいときは必ず聞くようにしています。"
        },
        {
          "turn_id": 14,
          "text": "完治すればとても楽に暮らせるんですが。"
        },
        {
          "turn_id": 15,
          "text": "本当にそう思います！"
        }
      ]
    },
    {
      "dialogue": "D3",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは。"
        },
        {
          "turn_id": 2,
          "text": "趣味は何ですか？"
        },
        {
          "turn_id": 3,
          "text": "何匹くらい飼ってるんですか？"
        },
        {
          "turn_id": 4,
          "text": "多いですね！"
        },
        {
          "turn_id": 5,
          "text": "メダカってお店とかに売ってるのですか？"
        },
        {
          "turn_id": 6,
          "text": "専門店もあるんですね！"
        },
        {
          "turn_id": 7,
          "text": "高額だとおいくらくらいなんですか？"
        },
        {
          "turn_id": 8,
          "text": "わお！何でそんなに高いんですか？"
        },
        {
          "turn_id": 9,
          "text": "品種改良ってことですか？"
        },
        {
          "turn_id": 10,
          "text": "あなたも改良とか試したりするのですか？"
        },
        {
          "turn_id": 11,
          "text": "うまくいくかは運的な要素も強いのですかね？"
        },
        {
          "turn_id": 12,
          "text": "どういう環境だといいのですか？"
        },
        {
          "turn_id": 13,
          "text": "なるほど！"
        },
        {
          "turn_id": 14,
          "text": "金魚とか鯉の改良の話はよく聞きますが、メダカでもあるなんて知らなかったです。"
        },
        {
          "turn_id": 15,
          "text": "ちょっと調べてみます！"
        }
      ]
    },
    {
      "dialogue": "D4",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは。"
        },
        {
          "turn_id": 2,
          "text": "海ですね。"
        },
        {
          "turn_id": 3,
          "text": "お魚が美味しいからです！"
        },
        {
          "turn_id": 4,
          "text": "あなたは海と山どちらが好きですか？"
        },
        {
          "turn_id": 5,
          "text": "なぜですか？"
        },
        {
          "turn_id": 6,
          "text": "山では何するのですか？"
        },
        {
          "turn_id": 7,
          "text": "温泉いいですよね！"
        },
        {
          "turn_id": 8,
          "text": "好きな温泉はありますか？"
        },
        {
          "turn_id": 9,
          "text": "行ったことないです！どんな温泉ですか？"
        },
        {
          "turn_id": 10,
          "text": "泊まりもできるのですか？"
        },
        {
          "turn_id": 11,
          "text": "新潟は食べ物も美味しそうだし是非行きたいです。"
        },
        {
          "turn_id": 12,
          "text": "美味しかったですか？"
        },
        {
          "turn_id": 13,
          "text": "新潟はお酒も美味しいイメージです。"
        },
        {
          "turn_id": 14,
          "text": "羨ましいです！"
        },
        {
          "turn_id": 15,
          "text": "はい！"
        }
      ]
    },
    {
      "dialogue": "D5",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "運動はしますか？"
        },
        {
          "turn_id": 3,
          "text": "どれくらいの頻度ですか？"
        },
        {
          "turn_id": 4,
          "text": "距離は？"
        },
        {
          "turn_id": 5,
          "text": "結構長いですね！"
        },
        {
          "turn_id": 6,
          "text": "最近涼しいですもんね！"
        },
        {
          "turn_id": 7,
          "text": "私も夏に中断していたランニングをこの前再開しました。"
        },
        {
          "turn_id": 8,
          "text": "４キロくらいです！"
        },
        {
          "turn_id": 9,
          "text": "だいぶゆっくりなペースではありますが。"
        },
        {
          "turn_id": 10,
          "text": "とりあえず三日坊主にならないように自分を戒めています。"
        },
        {
          "turn_id": 11,
          "text": "頑張って少しずつ負荷を上げられるように工夫しています。"
        },
        {
          "turn_id": 12,
          "text": "とりあえず４２キロ走ってみたいなと。"
        },
        {
          "turn_id": 13,
          "text": "はい！"
        },
        {
          "turn_id": 14,
          "text": "思った以上にしんどいですよね。"
        },
        {
          "turn_id": 15,
          "text": "それなのに走ろうとしている自分が不思議です。"
        }
      ]
    },
    {
      "dialogue": "D6",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "レンタカーでよくします！"
        },
        {
          "turn_id": 3,
          "text": "主に釣りに行くことが多いです。"
        },
        {
          "turn_id": 4,
          "text": "はい！釣ってその場でさばいて食べると最高です！"
        },
        {
          "turn_id": 5,
          "text": "イカとか姿作りにして食べてます！"
        },
        {
          "turn_id": 6,
          "text": "でも一回アニサキスにあたってえらい目にあいました。"
        },
        {
          "turn_id": 7,
          "text": "激痛でした！"
        },
        {
          "turn_id": 8,
          "text": "薬とかもないので、内視鏡取ってもらうしかなかったです。"
        },
        {
          "turn_id": 9,
          "text": "それ以来ちゃんと目視するようにはしています。"
        },
        {
          "turn_id": 10,
          "text": "イカを細切りにしてイカそうめんとかで刺身にするのは主にアニサキス対策らしいです。"
        },
        {
          "turn_id": 11,
          "text": "それを聞いて姿作りは諦めて、イカそうめんにしています。"
        },
        {
          "turn_id": 12,
          "text": "あなたは食あたりの経験とかありますか？"
        },
        {
          "turn_id": 13,
          "text": "どんな感じでしたか？"
        },
        {
          "turn_id": 14,
          "text": "ずっと下痢だったんですか？"
        },
        {
          "turn_id": 15,
          "text": "それは大変でしたね。"
        }
      ]
    },
    {
      "dialogue": "D7",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "夜ご飯は何食べるか決めましたか？"
        },
        {
          "turn_id": 3,
          "text": "候補は何かありますか？"
        },
        {
          "turn_id": 4,
          "text": "自分で作られるのですか？"
        },
        {
          "turn_id": 5,
          "text": "すごいですね！"
        },
        {
          "turn_id": 6,
          "text": "外食とかはあまりしないですか？"
        },
        {
          "turn_id": 7,
          "text": "洗い物しなくていいのが大きいなと個人的に思います。"
        },
        {
          "turn_id": 8,
          "text": "今もだいぶ溜まってしまっています。"
        },
        {
          "turn_id": 9,
          "text": "作るときにまとめて洗ってます。"
        },
        {
          "turn_id": 10,
          "text": "そうなる前には洗うようにしてます！"
        },
        {
          "turn_id": 11,
          "text": "自動食洗機が欲しいです。"
        },
        {
          "turn_id": 12,
          "text": "結構高いですしね。"
        },
        {
          "turn_id": 13,
          "text": "あると便利だけど必需品ではないですもんね。"
        },
        {
          "turn_id": 14,
          "text": "マメですごいですね！"
        },
        {
          "turn_id": 15,
          "text": "私も参考にさせてもらいます！"
        }
      ]
    },
    {
      "dialogue": "D8",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "日常品ですか？"
        },
        {
          "turn_id": 3,
          "text": "ちょっと高いウイスキーを買いました！"
        },
        {
          "turn_id": 4,
          "text": "はい、大好きです！"
        },
        {
          "turn_id": 5,
          "text": "お高いやつはやっぱり違いました！"
        },
        {
          "turn_id": 6,
          "text": "香りがまず違いました！"
        },
        {
          "turn_id": 7,
          "text": "味も結構フルーティーな感じでした。"
        },
        {
          "turn_id": 8,
          "text": "好きなお酒はありますか？"
        },
        {
          "turn_id": 9,
          "text": "自分でボトルを買ったりとかもしますか？"
        },
        {
          "turn_id": 10,
          "text": "わかります！"
        },
        {
          "turn_id": 11,
          "text": "お酒が飲みたくなってきました！"
        },
        {
          "turn_id": 12,
          "text": "梅酒作ってるんですか？"
        },
        {
          "turn_id": 13,
          "text": "難しいですか？"
        },
        {
          "turn_id": 14,
          "text": "ちょっと調べて作ってみようと思います！"
        },
        {
          "turn_id": 15,
          "text": "わかりました！"
        }
      ]
    },
    {
      "dialogue": "D9",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "明日の予定は決まってますか？"
        },
        {
          "turn_id": 3,
          "text": "何のですか？"
        },
        {
          "turn_id": 4,
          "text": "何を買う予定ですか？"
        },
        {
          "turn_id": 5,
          "text": "買いだめするのですね！"
        },
        {
          "turn_id": 6,
          "text": "計画的ですね！"
        },
        {
          "turn_id": 7,
          "text": "得意料理はなんですか？"
        },
        {
          "turn_id": 8,
          "text": "なんの煮物が多いですか？"
        },
        {
          "turn_id": 9,
          "text": "美味しそうですね！"
        },
        {
          "turn_id": 10,
          "text": "確かにおでんの大根とかも美味しいですもんね！"
        },
        {
          "turn_id": 11,
          "text": "私は炒め物くらいしか作れないので尊敬します！"
        },
        {
          "turn_id": 12,
          "text": "レシピ本とか見ながらやればできますかね？"
        },
        {
          "turn_id": 13,
          "text": "明日試してみます！"
        },
        {
          "turn_id": 14,
          "text": "なんだかお腹がすいてきました！"
        },
        {
          "turn_id": 15,
          "text": "私も今日何作るか考えないと。"
        }
      ]
    },
    {
      "dialogue": "D10",
      "partner": "A1",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんばんは。"
        },
        {
          "turn_id": 2,
          "text": "赤ですね！"
        },
        {
          "turn_id": 3,
          "text": "確かに赤い服もありますが、ちょっと派手なので少ない気はします。"
        },
        {
          "turn_id": 4,
          "text": "青が好きな理由とかありますか？"
        },
        {
          "turn_id": 5,
          "text": "確かに爽やかですもんね！"
        },
        {
          "turn_id": 6,
          "text": "私はなんかざっくりしてるんですけど、赤は心が踊るような気がして。"
        },
        {
          "turn_id": 7,
          "text": "逆に嫌いな色はありますか？"
        },
        {
          "turn_id": 8,
          "text": "私はピンクが苦手です。"
        },
        {
          "turn_id": 9,
          "text": "ピンクが好きな知り合いがいるのですが、なかなかしんどいなと思ってしまいます。"
        },
        {
          "turn_id": 10,
          "text": "そういえば衣変えとかはしましたか？"
        },
        {
          "turn_id": 11,
          "text": "もうそろそろしないとですよね。"
        },
        {
          "turn_id": 12,
          "text": "私はこの３連休にするはずだったんですが。"
        },
        {
          "turn_id": 13,
          "text": "怠惰なもので。"
        },
        {
          "turn_id": 14,
          "text": "とりあえず明日頑張ろうと思います！"
        },
        {
          "turn_id": 15,
          "text": "お互い頑張りましょう！"
        }
      ]
    },
    {
      "dialogue": "D11",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "今日は何をしていましたか？"
        },
        {
          "turn_id": 3,
          "text": "3連休はどこかお出かけされたりはしないんですか？"
        },
        {
          "turn_id": 4,
          "text": "そうなんですね。普段からあまりお出かけはされないんですか？"
        },
        {
          "turn_id": 5,
          "text": "コロナの影響ですか？"
        },
        {
          "turn_id": 6,
          "text": "全国旅行支援とか新しい政策もあったりして、世間的には自粛ムードもなくなりつつありますが、大変ですね。"
        },
        {
          "turn_id": 7,
          "text": "そうですね。車でちょっと遠出とかよくします。"
        },
        {
          "turn_id": 8,
          "text": "そうですね。高速に乗っていくこともあれば、下道で隣の県まで行ったりもします。"
        },
        {
          "turn_id": 9,
          "text": "ドライブとかよくされますか？"
        },
        {
          "turn_id": 10,
          "text": "いつもと違う道だとちょっと気分変わりますよね"
        },
        {
          "turn_id": 11,
          "text": "わかります。途中でナビ使ったりしちゃいます。"
        },
        {
          "turn_id": 12,
          "text": "ちょっとしたドライブですよね。"
        },
        {
          "turn_id": 13,
          "text": "山道怖くないですか？細かったり路面悪かったり。"
        },
        {
          "turn_id": 14,
          "text": "ドライブが好きなのですか？車自体が好きなのですか？"
        },
        {
          "turn_id": 15,
          "text": "なるほど、走るのが好きなのですね。いい気分転換ですよね。"
        }
      ]
    },
    {
      "dialogue": "D12",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "私は冬ですね"
        },
        {
          "turn_id": 3,
          "text": "暑いよりかは寒い方がというところですね。あとは冬は花粉がないので。"
        },
        {
          "turn_id": 4,
          "text": "はい。春は特にひどいですね。"
        },
        {
          "turn_id": 5,
          "text": "花粉症でないのは羨ましいです。点鼻薬がもう手放せなくて。"
        },
        {
          "turn_id": 6,
          "text": "私は点鼻薬だけは市販のを使っています。即効性があるので"
        },
        {
          "turn_id": 7,
          "text": "大人になってからなる人が多いイメージです。"
        },
        {
          "turn_id": 8,
          "text": "ちなみにあなたはどの季節が好きですか？"
        },
        {
          "turn_id": 9,
          "text": "なぜですか？"
        },
        {
          "turn_id": 10,
          "text": "春も過ごしやすい気温かなあと思いますが、春はどうですか？"
        },
        {
          "turn_id": 11,
          "text": "花粉症でない人は、春が過ごしやすくて好きな人が多いと思っていました。"
        },
        {
          "turn_id": 12,
          "text": "たしかに、3月とかはもう春ですが、まだコートが手放せなかったりしますしね"
        },
        {
          "turn_id": 13,
          "text": "確かに、春は気温差が激しいイメージです。"
        },
        {
          "turn_id": 14,
          "text": "最近の気温差は激しいですよね"
        },
        {
          "turn_id": 15,
          "text": "暖かいものが手放せないですね"
        }
      ]
    },
    {
      "dialogue": "D13",
      "partner": "A2",
      "visible_turns": [
        {
          "turn_id": 1,
          "text": "こんにちは"
        },
        {
          "turn_id": 2,
          "text": "今日も寒いですね。"
        },
        {
          "turn_id": 3,
          "text": "昨日はこちらは雨が降っていたのですが、そちらはどうですか？"
        },
        {
          "turn_id": 4,
          "text": "寒い日に雨降られると、より寒く感じてしまいますよね"
        },
        {
          "turn_id": 5,
